; Песочница, в которой Homebrew гоняет `brew test` (сверено с
; Library/Homebrew/extend/os/mac/sandbox.rb, Homebrew 4.x, 2026-09-21):
; запись — только во временные каталоги, без mach-lookup к службам системы
; (TCC отвечает «нет» на любое право), без сети. release.sh прогоняет в ней
; самопроверки до push: проверка, которая молча опирается на права машины,
; падает здесь, а не в brew test после выпуска.
(version 1)
(deny network-outbound (to unix-socket))
(deny network*)
(allow network* (local ip "localhost:*"))
(allow network* (remote ip "localhost:*"))
(allow file-write-setugid
    (subpath "/private/tmp")
    (subpath "/private/var/tmp")
    (regex #"^/private/var/folders/[^/]+/[^/]+/[C,T]/"))
(allow file-write-mode
    (subpath "/private/tmp")
    (subpath "/private/var/tmp")
    (regex #"^/private/var/folders/[^/]+/[^/]+/[C,T]/"))
(allow file-write*
    (subpath "/private/tmp")
    (subpath "/private/var/tmp")
    (regex #"^/private/var/folders/[^/]+/[^/]+/[C,T]/")
    (literal "/dev/ptmx")
    (literal "/dev/dtracehelper")
    (literal "/dev/null")
    (literal "/dev/random")
    (literal "/dev/zero")
    (regex #"^/dev/fd/[0-9]+$")
    (regex #"^/dev/tty[a-z0-9]*$")
    )
(deny file-write*)
(deny file-write-setugid)
(deny file-write-mode)
(deny mach-lookup)
(allow mach-lookup
    (xpc-service-name "com.apple.MTLCompilerService")
    (global-name "com.apple.mobileassetd.v2")
    (global-name "com.apple.sysmond")
    (global-name "com.apple.lsd.mapdb")
    (global-name "com.apple.bsd.dirhelper")
    (global-name "com.apple.system.opendirectoryd.libinfo")
    (global-name "com.apple.system.opendirectoryd.membership")
    (global-name "com.apple.PowerManagement.control")
    (global-name "com.apple.SecurityServer")
    (global-name "com.apple.networkd")
    (global-name "com.apple.ocspd")
    (global-name "com.apple.trustd.agent")
    (global-name "com.apple.SystemConfiguration.DNSConfiguration")
    (global-name "com.apple.SystemConfiguration.configd")
    )
(deny lsopen)
(deny appleevent-send)
(allow process-exec
    (literal "/bin/ps")
    (with no-sandbox)
    )
(allow default)
