#!/bin/bash
#
# ocbar — клиент Cisco AnyConnect (OpenConnect) для macOS: SSO через WKWebView,
# split DNS через /etc/resolver, split tunneling, супервизор, меню-бар.
#
# Автор: ValeraGin — Ignatkovich Valery. Лицензия MIT.
#
# Этот файл работает от пользователя и НИЧЕГО привилегированного не делает сам:
# всё, что требует root, уходит в libexec/ocbar-helper (см. DECISIONS.md, D2).
# --dry-run печатает команды хелпера вместо выполнения.

set -euo pipefail

# Свой PATH: не полагаемся на пользовательский (из Finder/launchd он куцый).
PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export LC_CTYPE="${LC_CTYPE:-UTF-8}"

VERSION="0.1.0"
# SELF_ENTRY — как нас позвали (например, /opt/homebrew/bin/ocbar: этот путь
# переживает brew upgrade, его кладём в plist). SELF — реальный файл после
# симлинков (Cellar), рядом с ним лежат libexec/ocbar-helper и ocbar-auth.
SELF_ENTRY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
SELF="$SELF_ENTRY"
while [ -L "$SELF" ]; do
    _t=$(readlink "$SELF"); case "$_t" in /*) SELF="$_t" ;; *) SELF="$(dirname "$SELF")/$_t" ;; esac
done
SELF="$(cd "$(dirname "$SELF")" && pwd)/$(basename "$SELF")"
SELF_DIR="$(dirname "$SELF")"

CONFIG_DIR="${OCBAR_CONFIG_DIR:-$HOME/.config/ocbar}"
PROFILE_DIR="$CONFIG_DIR/profiles"      # по файлу на подключение, формат .ocbar
PROFILES="$CONFIG_DIR/profiles.conf"
ZONES_CONF="${OCBAR_CONFIG:-$CONFIG_DIR/zones.conf}"
NETWORKS_CONF="${OCBAR_NETWORKS:-$CONFIG_DIR/networks.conf}"
RULES_FILE="$CONFIG_DIR/autofill.rules"

USER_STATE="${OCBAR_USER_STATE:-$HOME/Library/Application Support/ocbar}"
DESIRED="$USER_STATE/desired"            # имя профиля, который должен быть поднят
SUP_PID="$USER_STATE/supervisor.pid"
SUP_CODE="$USER_STATE/supervisor.code-mtime"   # с какой версией скрипта он работает
NEEDS_LOGIN="$USER_STATE/needs-login"    # автоподключение упёрлось во вход, ждём человека
LINK_LOST="$USER_STATE/link-lost"        # отметка времени: с какого момента проба не проходит
ROUTES_OFF="$USER_STATE/routes.disabled" # сети из networks.conf, выключенные из меню
ZONES_OFF="$USER_STATE/zones.disabled"
LOG_DIR="$HOME/Library/Logs/ocbar"
SUP_LOG="$LOG_DIR/supervisor.log"

PREFIX="/usr/local"
HELPER_INSTALLED="$PREFIX/libexec/ocbar-helper"
LIBDIR="$PREFIX/libexec/ocbar"
STATE_DIR="${OCBAR_STATE_DIR:-$PREFIX/var/ocbar}"   # пишет только хелпер (root)
TUNNEL_ENV="$STATE_DIR/tunnel.env"
PIDFILE="$STATE_DIR/openconnect.pid"
MANIFEST="$STATE_DIR/zones.state"
PAUSED_FLAG="$STATE_DIR/paused"
ROUTES_STATE="$STATE_DIR/routes.state"
OC_LOG="$STATE_DIR/openconnect.log"
RESOLVER_DIR="/etc/resolver"
AGENT_LABEL="ru.ocbar.supervisor"
AGENT_PLIST="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"
APP_LABEL="ru.ocbar.app"                 # приложение меню-бара, запуск при входе
APP_PLIST="$HOME/Library/LaunchAgents/$APP_LABEL.plist"

DRY_RUN=0
NOTIFY_ENABLED=1     # ключ notifications = off в profiles.conf выключает

# ---------------------------------------------------------------- вывод ----
c_red=$'\033[31m'; c_grn=$'\033[32m'; c_yel=$'\033[33m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
[ -t 1 ] || { c_red=""; c_grn=""; c_yel=""; c_dim=""; c_off=""; }
# printf '%-Ns' считает БАЙТЫ — кириллица съезжает. Паддинг руками.
pad() { local out="$1" w="${2:-26}"; while [ "${#out}" -lt "$w" ]; do out="$out "; done; printf '%s' "$out"; }
_line() {
    local color="$1" tag="$2"; shift 2
    if [ $# -gt 1 ]; then printf '  %s[%s]%s %s %s\n' "$color" "$tag" "$c_off" "$(pad "$1")" "$2"
    else printf '  %s[%s]%s %s\n' "$color" "$tag" "$c_off" "${1:-}"; fi
}
ok()   { _line "$c_grn" " OK " "$@"; }
warn() { _line "$c_yel" " !! " "$@"; }
bad()  { _line "$c_red" "FAIL" "$@"; }
skip() { _line "$c_dim" " -- " "$@"; }
info() { printf '%s\n' "$*"; }
die()  { printf '%socbar: %s%s\n' "$c_red" "$*" "$c_off" >&2; exit 1; }
log()  { mkdir -p "$LOG_DIR"; printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$SUP_LOG"; }

# Лог пишется дозаписью на каждый вызов log(), поэтому переименовать файл
# безопасно: следующая запись создаст новый. Для лога openconnect это не так
# (дескриптор держит процесс), там ротация делается при запуске туннеля.
rotate_log() { # файл [предел байт] [сколько хранить]
    local f="$1" max="${2:-1048576}" keep="${3:-2}" size i
    [ -f "$f" ] || return 0
    size=$(stat -f %z "$f" 2>/dev/null || echo 0)
    [ "$size" -ge "$max" ] || return 0
    i=$keep
    while [ "$i" -gt 1 ]; do
        [ -f "$f.$((i-1))" ] && mv -f "$f.$((i-1))" "$f.$i"
        i=$((i-1))
    done
    mv -f "$f" "$f.1"
    log "лог превысил $((max/1024)) КБ — предыдущий сохранён как $(basename "$f").1"
}

# Уведомление системы. Текст передаётся аргументом, а не подстановкой в текст
# скрипта: иначе кавычки в сообщении ломают osascript.
notify() { # заголовок, текст
    [ "${OCBAR_NOTIFY:-1}" = 1 ] || return 0
    [ "$NOTIFY_ENABLED" = 0 ] && return 0
    osascript - "$1" "$2" >/dev/null 2>&1 <<'AS' || true
on run argv
    display notification (item 2 of argv) with title (item 1 of argv)
end run
AS
}

# ------------------------------------------------------------ бинарники ----
helper_path() {
    if [ -x "$HELPER_INSTALLED" ]; then printf '%s' "$HELPER_INSTALLED"
    elif [ -x "$SELF_DIR/../libexec/ocbar-helper" ]; then printf '%s' "$(cd "$SELF_DIR/../libexec" && pwd)/ocbar-helper"
    else return 1; fi
}
helper_nopasswd() { sudo -n -l "$HELPER_INSTALLED" >/dev/null 2>&1; }

# Источник для установки — только файл из дерева рядом с CLI. helper_path()
# для этого не годится: он предпочитает уже установленный, и install начинал
# копировать файл сам в себя.
helper_source() {
    local c="$SELF_DIR/../libexec/ocbar-helper"
    [ -f "$c" ] || return 1
    printf '%s' "$(cd "$(dirname "$c")" && pwd)/$(basename "$c")"
}

auth_path() {
    local c
    for c in "${OCBAR_AUTH:-}" "$SELF_DIR/../libexec/ocbar-auth" "$SELF_DIR/../auth/.build/release/ocbar-auth" \
             /opt/homebrew/opt/ocbar/libexec/ocbar-auth /usr/local/opt/ocbar/libexec/ocbar-auth; do
        [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
    done
    return 1
}

openconnect_bin() {
    local c
    for c in /opt/homebrew/bin/openconnect /usr/local/bin/openconnect; do [ -x "$c" ] && { printf '%s' "$c"; return 0; }; done
    return 1
}

# Привилегированная операция → хелпер. stdin пробрасывается как есть.
priv() {
    local h; h=$(helper_path) || die "не найден ocbar-helper (ни $HELPER_INSTALLED, ни в libexec/ рядом)"
    if [ "$DRY_RUN" = 1 ]; then
        printf '  %s$ sudo ocbar-helper %s%s\n' "$c_dim" "$*" "$c_off"
        OCBAR_STATE_DIR="$STATE_DIR" "$h" --dry-run "$@"
        return
    fi
    if [ "$h" = "$HELPER_INSTALLED" ] && helper_nopasswd; then
        sudo -n "$h" "$@"
    else
        [ -t 0 ] || [ -t 2 ] || die "хелпер не установлен под NOPASSWD, а терминала для пароля нет — sudo ocbar install"
        printf '%socbar: хелпер без NOPASSWD — sudo спросит пароль (sudo ocbar install чинит это навсегда)%s\n' "$c_yel" "$c_off" >&2
        sudo "$h" "$@"
    fi
}

# ------------------------------------------------------------- профили ----
# profiles.conf:  default = имя
#                 [имя]  url = host/group  name = …  user = …  mode = split|full
#                        auth = sso|password  useragent = …  keychain_service = …
#                        csd_wrapper = /путь  rules = /путь  totp = auto|keepassxc|off
profile_get() { # имя ключ
    [ -f "$PROFILES" ] || return 0
    awk -v s="[$1]" -v k="$2" '
        $0 == s { inside = 1; next }
        /^\[/   { inside = 0 }
        inside && $0 ~ "^[ \t]*" k "[ \t]*=" { sub("^[^=]*=[ \t]*", ""); sub("[ \t]+$", ""); print; exit }
    ' "$PROFILES"
}
# --- профиль одним файлом (.ocbar), по образцу конфигов WireGuard ---
#
# Секции: [Connection] ключ = значение · [Routes] список сетей ·
# [DNS] зона = резолвер · [Auth] ключ = значение · [Health] ключ = значение.
# Файл самодостаточен: сети и зоны живут в нём, а не в общих конфигах.

profile_file() { # имя → путь файла или пусто
    # Всегда возвращает 0: при set -e присваивание вида f=$(profile_file x)
    # с ненулевым кодом завершает скрипт, а «файла нет» — это не ошибка.
    local f="$PROFILE_DIR/$1.ocbar"
    [ -n "${1:-}" ] && [ -f "$f" ] && printf '%s' "$f"
    return 0
}

# Значение ключа из указанной секции. Регистр ключа не важен.
pf_get() { # файл секция ключ
    [ -f "$1" ] || return 0
    awk -v want="$2" -v key="$3" '
        function trim(x) { sub(/^[ \t]+/, "", x); sub(/[ \t\r]+$/, "", x); return x }
        /^[ \t]*\[/ { sec = trim($0); gsub(/^\[|\]$/, "", sec); next }
        /^[ \t]*[#;]/ { next }
        {
            line = trim($0)
            if (line == "" || index(line, "=") == 0) next
            k = trim(substr(line, 1, index(line, "=") - 1))
            v = trim(substr(line, index(line, "=") + 1))
            if (tolower(sec) == tolower(want) && tolower(k) == tolower(key)) { print v; exit }
        }
    ' "$1"
}

# Все строки секции как есть (для [Routes]) или пары «ключ значение» (для [DNS]).
pf_section() { # файл секция
    [ -f "$1" ] || return 0
    awk -v want="$2" '
        function trim(x) { sub(/^[ \t]+/, "", x); sub(/[ \t\r]+$/, "", x); return x }
        /^[ \t]*\[/ { sec = trim($0); gsub(/^\[|\]$/, "", sec); next }
        /^[ \t]*[#;]/ { next }
        {
            line = trim($0)
            if (line == "" || tolower(sec) != tolower(want)) next
            if (index(line, "=") > 0) {
                k = trim(substr(line, 1, index(line, "=") - 1))
                v = trim(substr(line, index(line, "=") + 1))
                print k " " v
            } else print line
        }
    ' "$1"
}

profile_files() { [ -d "$PROFILE_DIR" ] && ls "$PROFILE_DIR"/*.ocbar 2>/dev/null | while read -r f; do basename "$f" .ocbar; done || true; }

# Глобальные ключи из шапки profiles.conf (до первой секции).
global_get() {
    [ -f "$PROFILES" ] || return 0
    awk -v k="$1" '/^\[/{exit} $0 ~ "^[ \t]*" k "[ \t]*=" {sub("^[^=]*=[ \t]*",""); sub("[ \t]+$",""); print; exit}' "$PROFILES"
}

profile_default() {
    # 1) явный default в старом profiles.conf
    if [ -f "$PROFILES" ]; then
        local d; d=$(awk '/^\[/{exit} /^[ \t]*default[ \t]*=/{sub("^[^=]*=[ \t]*",""); sub("[ \t\r]+$",""); print; exit}' "$PROFILES")
        [ -n "$d" ] && { printf '%s' "$d"; return 0; }
    fi
    # 2) файл-профиль с именем default, 3) единственный файл-профиль
    [ -n "$(profile_file default)" ] && { printf 'default'; return 0; }
    local files; files=$(profile_files)
    [ "$(printf '%s\n' "$files" | grep -c .)" = 1 ] && printf '%s' "$files"
}
profile_list() {
    # Завершающий `true` обязателен: без него отсутствие profiles.conf делает
    # код группы ненулевым, а с pipefail это рушит весь конвейер — и
    # profile_exists начинает врать «профиля нет» при существующем профиле.
    { profile_files; [ -f "$PROFILES" ] && sed -n 's/^\[\(.*\)\]$/\1/p' "$PROFILES"; true; } 2>/dev/null \
        | awk 'NF && !seen[$0]++'
}

# "имя|name|auth" по всем профилям за один проход: раньше это было два
# вызова awk на каждый профиль, то есть шестнадцать процессов на восемь строк.
profiles_summary() {
    local n f
    while read -r n; do
        [ -n "$n" ] || continue
        f=$(profile_file "$n")
        [ -n "$f" ] && printf '%s|%s|%s|%s\n' "$n" "$(pf_get "$f" Connection Name)" "$(pf_get "$f" Connection Auth)" "$(pf_get "$f" Connection Description)"
    done <<< "$(profile_files)"
    [ -f "$PROFILES" ] || return 0
    awk '
        function val(line,   v) { v = line; sub("^[^=]*=[ \t]*", "", v); sub("[ \t\r]+$", "", v); return v }
        /^\[/ { if (cur != "") print cur "|" nm "|" au "|" ds; cur = $0; gsub(/^\[|\]$/, "", cur); nm = ""; au = ""; ds = ""; next }
        /^[ \t]*name[ \t]*=/        { if (nm == "") nm = val($0) }
        /^[ \t]*auth[ \t]*=/        { if (au == "") au = val($0) }
        /^[ \t]*description[ \t]*=/ { if (ds == "") ds = val($0) }
        END { if (cur != "") print cur "|" nm "|" au "|" ds }
    ' "$PROFILES"
}
profile_exists() { profile_list | grep -Fxq "$1"; }

# Профиль → переменные P_*
load_profile() {
    local p="${1:-}"
    [ -n "$p" ] || p=$(profile_default)
    [ -n "$p" ] || die "нет профиля: укажи имя или default в $PROFILES (образец: etc/profiles.conf.example)"
    profile_exists "$p" || die "профиля [$p] нет (есть: $(profile_list | tr '\n' ' ')); ищу в $PROFILE_DIR/*.ocbar и в $PROFILES"
    P_NAME="$p"
    P_FILE=$(profile_file "$p")
    if [ -n "$P_FILE" ]; then load_profile_file "$P_FILE" "$p"; return 0; fi
    P_KIND=tunnel; P_PROXY_PORT=11080; P_SYS_PROXY=off
    P_URL=$(profile_get "$p" url);   [ -n "$P_URL" ] || die "у профиля [$p] нет url"
    P_TITLE=$(profile_get "$p" name); P_TITLE="${P_TITLE:-$p}"
    P_USER=$(profile_get "$p" user);  P_USER="${P_USER:-$(id -un)}"
    P_MODE=$(profile_get "$p" mode);  P_MODE="${P_MODE:-split}"
    P_AUTH=$(profile_get "$p" auth);  P_AUTH="${P_AUTH:-sso}"
    P_UA=$(profile_get "$p" useragent); P_UA="${P_UA:-AnyConnect Windows 4.10.06079}"
    P_SVC=$(profile_get "$p" keychain_service); P_SVC="${P_SVC:-ru.ocbar.client}"
    P_CSD=$(profile_get "$p" csd_wrapper)
    # Откуда брать одноразовый код. Источников несколько, и ни один не
    # «главный»: keychain — секрет в связке ключей, keepassxc — готовый код из
    # базы, command — произвольная команда (менеджер паролей, свой скрипт),
    # off — вводит человек.
    P_PASSWORD=$(profile_get "$p" password); P_PASSWORD="${P_PASSWORD:-auto}"
    P_PW_CMD=$(profile_get "$p" password_command)
    P_TOTP=$(profile_get "$p" totp); P_TOTP="${P_TOTP:-auto}"
    P_TOTP_CMD=$(profile_get "$p" totp_command)
    P_KP_ENTRY=$(profile_get "$p" keepass_entry)
    P_KP_DB=$(profile_get "$p" keepass_db); P_KP_DB="${P_KP_DB/#\~/$HOME}"
    P_KP_SVC=$(profile_get "$p" keepass_keychain_service)
    P_HEALTH=$(profile_get "$p" healthcheck)
    # Хосты, где разрешено автозаполнение. Пусто — заполняем везде, как раньше,
    # но в лог попадёт хост каждой страницы, по нему список и составляется.
    P_FILL_HOSTS=$(profile_get "$p" idp_hosts)
    case "$(global_get notifications)" in off|0|no) NOTIFY_ENABLED=0 ;; esac
    # auto = «сам разберись»: команда, если задана; база, если указана запись;
    # иначе связка ключей.
    if [ "$P_TOTP" = auto ]; then
        if [ -n "$P_TOTP_CMD" ]; then P_TOTP=command
        elif [ -n "$P_KP_ENTRY" ]; then P_TOTP=keepassxc
        else P_TOTP=keychain; fi
    fi
    case "$P_PASSWORD" in
        auto|keychain|keepassxc|command|ask) ;;
        *) die "профиль [$P_NAME]: password = auto | keychain | keepassxc | command | ask, а не '$P_PASSWORD'" ;;
    esac
    P_RULES=$(profile_get "$p" rules); P_RULES="${P_RULES/#\~/$HOME}"
    [ -n "$P_RULES" ] || { [ -f "$RULES_FILE" ] && P_RULES="$RULES_FILE" || P_RULES=""; }
    case "$P_MODE" in
        split) ;;
        full)  die "профиль [$p]: режим full убран (он не работал). Полный туннель — двумя строками в networks.conf: 0.0.0.0/1 и 128.0.0.0/1. Учтите, что шлюз может не выпускать наружу" ;;
        *)     die "профиль [$p]: mode = split, а не '$P_MODE'" ;;
    esac
}

# Загрузить профиль, если он вообще загружается. Нужен там, где отсутствие
# профиля не должно рушить работу: показ состояния, меню. Сначала пробуем в
# подоболочке (там die безвреден), и только потом — по-настоящему.
try_load_profile() {
    [ -n "${1:-}" ] || return 1
    ( load_profile "$1" ) >/dev/null 2>&1 || return 1
    load_profile "$1"
}

# Профиль из отдельного файла. Заполняет те же переменные, что и старый путь,
# поэтому остальной код о формате не знает.
load_profile_file() { # файл имя
    local f="$1"
    P_NAME="$2"; P_FILE="$f"
    P_URL=$(pf_get "$f" Connection Url); [ -n "$P_URL" ] || die "в $f нет Url в секции [Connection]"
    P_TITLE=$(pf_get "$f" Connection Name); P_TITLE="${P_TITLE:-$2}"
    P_DESCR=$(pf_get "$f" Connection Description)
    P_USER=$(pf_get "$f" Connection User); P_USER="${P_USER:-$(id -un)}"
    P_UA=$(pf_get "$f" Connection UserAgent); P_UA="${P_UA:-AnyConnect Windows 4.10.06079}"
    P_CSD=$(pf_get "$f" Connection CsdWrapper); P_CSD="${P_CSD/#\~/$HOME}"
    P_MODE=split
    P_AUTH=$(pf_get "$f" Connection Auth); P_AUTH="${P_AUTH:-sso}"
    # Как пускать трафик: tunnel — интерфейс и маршруты (сегодняшний путь),
    # proxy — локальный SOCKS через ocproxy (docs/09-proxy-mode.md, пока не
    # реализовано). Это не то же самое, что mode = split|full в старом
    # profiles.conf: там речь о том, что заворачивать, а не чем.
    P_KIND=$(pf_get "$f" Connection Mode); P_KIND="${P_KIND:-tunnel}"
    case "$P_KIND" in
        tunnel|proxy) ;;
        *) die "профиль [$2]: Mode = tunnel или proxy, а не '$P_KIND'" ;;
    esac
    P_PROXY_PORT=$(pf_get "$f" Proxy Port); P_PROXY_PORT="${P_PROXY_PORT:-11080}"
    case "$P_PROXY_PORT" in
        ''|*[!0-9]*) die "профиль [$2]: Proxy Port = число, а не '$P_PROXY_PORT'" ;;
    esac
    [ "$P_PROXY_PORT" -ge 1024 ] && [ "$P_PROXY_PORT" -le 65535 ] \
        || die "профиль [$2]: Proxy Port вне диапазона 1024-65535"
    P_SYS_PROXY=$(pf_get "$f" Proxy SystemProxy); P_SYS_PROXY="${P_SYS_PROXY:-off}"

    P_SVC=$(pf_get "$f" Auth KeychainService); P_SVC="${P_SVC:-ru.ocbar.client}"
    P_PASSWORD=$(pf_get "$f" Auth Password); P_PASSWORD="${P_PASSWORD:-auto}"
    P_PW_CMD=$(pf_get "$f" Auth PasswordCommand)
    P_TOTP=$(pf_get "$f" Auth Totp); P_TOTP="${P_TOTP:-auto}"
    P_TOTP_CMD=$(pf_get "$f" Auth TotpCommand)
    P_KP_ENTRY=$(pf_get "$f" Auth KeepassEntry)
    P_KP_DB=$(pf_get "$f" Auth KeepassDb); P_KP_DB="${P_KP_DB/#\~/$HOME}"
    P_KP_SVC=$(pf_get "$f" Auth KeepassKeychain)
    P_FILL_HOSTS=$(pf_get "$f" Auth IdpHosts)
    P_RULES=$(pf_get "$f" Auth Rules); P_RULES="${P_RULES/#\~/$HOME}"
    [ -n "$P_RULES" ] || { [ -f "$RULES_FILE" ] && P_RULES="$RULES_FILE" || P_RULES=""; }
    if [ "$P_TOTP" = auto ]; then
        if [ -n "$P_TOTP_CMD" ]; then P_TOTP=command
        elif [ -n "$P_KP_ENTRY" ]; then P_TOTP=keepassxc
        else P_TOTP=keychain; fi
    fi
    case "$P_PASSWORD" in
        auto|keychain|keepassxc|command|ask) ;;
        *) die "профиль [$P_NAME]: password = auto | keychain | keepassxc | command | ask, а не '$P_PASSWORD'" ;;
    esac
    P_HEALTH=$(pf_get "$f" Health Check)
    case "$(pf_get "$f" Connection Notifications)" in off|0|no) NOTIFY_ENABLED=0 ;; esac
}

# ------------------------------------------------------------- конфиги ----
# Без подпроцессов: status зовётся плагином меню каждые 5 с, и каждый
# grep здесь — отдельный процесс на каждую зону и сеть.
valid_zone() {
    case "$1" in ''|.*|*/*|*' '*|*'..'*) return 1 ;; esac
    local re='^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$'
    [[ $1 =~ $re ]]
}
valid_ip() {
    local re='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
    [[ $1 =~ $re ]] || return 1
    local IFS=. o; for o in $1; do [ "$o" -le 255 ] || return 1; done
}
valid_cidr() {
    case "$1" in */*) ;; *) return 1 ;; esac
    valid_ip "${1%/*}" || return 1
    local len="${1#*/}" re='^[0-9]{1,2}$'
    [[ $len =~ $re ]] && [ "$len" -le 32 ]
}

# zones.conf: "<зона> <DNS|vpn> [порт]"
read_zones() {
    # Профиль-файл самодостаточен: зоны берутся из него, а не из общего конфига.
    if [ -n "${P_FILE:-}" ] && [ -f "$P_FILE" ]; then
        local zone dns port
        pf_section "$P_FILE" DNS | while read -r zone dns port _; do
            [ -n "${zone:-}" ] && [ -n "${dns:-}" ] || continue
            valid_zone "$zone" || { warn "недопустимое имя зоны, пропущено: $zone" >&2; continue; }
            [ "$dns" = vpn ] || valid_ip "$dns" || { warn "недопустимый адрес, пропущено: $zone $dns" >&2; continue; }
            printf '%s %s %s\n' "$zone" "$dns" "${port:-53}"
        done
        return 0
    fi
    [ -f "$ZONES_CONF" ] || return 0
    local zone dns port
    while read -r zone dns port _; do
        case "${zone:-}" in ''|\#*) continue ;; esac
        [ -n "${dns:-}" ] || { warn "строка без DNS пропущена: $zone" >&2; continue; }
        valid_zone "$zone" || { warn "недопустимое имя зоны, пропущено: $zone" >&2; continue; }
        [ "$dns" = vpn ] || valid_ip "$dns" || { warn "недопустимый адрес, пропущено: $zone $dns" >&2; continue; }
        printf '%s %s %s\n' "$zone" "$dns" "${port:-53}"
    done < "$ZONES_CONF"
}
read_networks() {
    if [ -n "${P_FILE:-}" ] && [ -f "$P_FILE" ]; then
        local n
        pf_section "$P_FILE" Routes | while read -r n _; do
            [ -n "${n:-}" ] || continue
            valid_cidr "$n" || { warn "некорректная сеть в профиле: $n" >&2; continue; }
            case "${n#*/}" in
                0|1|2|3|4|5|6|7) warn "сеть $n уводит в туннель почти весь трафик" >&2 ;;
            esac
            printf '%s\n' "$n"
        done
        return 0
    fi
    [ -f "$NETWORKS_CONF" ] || return 0
    local n
    while read -r n _; do
        case "${n:-}" in ''|\#*) continue ;; esac
        valid_cidr "$n" || { warn "некорректная сеть в networks.conf: $n" >&2; continue; }
        # Сеть с маской короче /8 уводит в туннель почти весь трафик. Это
        # законный способ получить полный туннель, но случайная опечатка тут
        # оставляет без интернета, поэтому предупреждаем явно.
        case "${n#*/}" in
            0|1|2|3|4|5|6|7) warn "сеть $n уводит в туннель почти весь трафик — интернет пойдёт через шлюз" >&2 ;;
        esac
        printf '%s\n' "$n"
    done < "$NETWORKS_CONF"
}
is_off() { [ -f "$2" ] && grep -qx "$1" "$2"; }
active_zones()    { read_zones    | while read -r z d p; do is_off "$z" "$ZONES_OFF"  || printf '%s %s %s\n' "$z" "$d" "$p"; done; }
active_networks() { read_networks | while read -r n;     do is_off "$n" "$ROUTES_OFF" || printf '%s\n' "$n"; done; }

# ----------------------------------------------------------- состояние ----
env_get() { [ -f "$TUNNEL_ENV" ] && sed -n "s/^$1=//p" "$TUNNEL_ENV" | head -1 || true; }
tunnel_pid() { [ -f "$PIDFILE" ] && grep -E '^[0-9]+$' "$PIDFILE" 2>/dev/null || true; }
# Номер процесса переживает перезагрузку и достаётся кому попало. Без сверки
# имени супервизор считает живым чужой процесс, а хелпер шлёт ему сигнал от
# root. Поэтому проверяем, что это действительно openconnect.
tunnel_alive() {
    local p; p=$(tunnel_pid); [ -n "$p" ] || return 1
    case "$(ps -p "$p" -o comm= 2>/dev/null)" in *openconnect) return 0 ;; *) return 1 ;; esac
}
is_paused() { [ -f "$PAUSED_FLAG" ]; }
# paused — это подсостояние connected: процесс жив, сессия цела, но трафик
# идёт мимо туннеля. Отдельное имя нужно, чтобы супервизор не «чинил» это.
tunnel_state() {
    if tunnel_alive && [ "$(env_get STATE)" = connected ]; then
        is_paused && echo paused || echo connected
    elif tunnel_alive; then echo starting
    else echo down; fi
}

# utun туннеля: из tunnel.env, иначе (чужая сессия) — по маршруту первой сети.
tunnel_iface() {
    local d; d=$(env_get TUNDEV)
    if [ -n "$d" ] && [ "$(env_get STATE)" = connected ]; then printf '%s' "$d"; return 0; fi
    local n; n=$(read_networks | head -1)
    [ -n "$n" ] && route_via "$n"
}
# Куда реально пойдёт трафик этой сети. Раньше здесь разбирался вывод
# netstat, и это было неверно дважды: бралась не та колонка (у строк с
# полем Expire последняя колонка — оно), а формат записи угадывался по
# длине префикса, хотя BSD опускает её только для «классовых» масок.
# Спрашиваем ядро — оно знает точно.
#
# Пробуем ПЕРВЫЙ адрес сети, а не нулевой: `route get 172.16.0.0` попадает
# в default (ядро трактует .0 особо), а `route get 172.16.0.1` отвечает
# верно. Проверено на живой таблице.
route_via() { # cidr → интерфейс
    local base="${1%%/*}" len="${1#*/}" probe
    if [ "$len" = 32 ]; then
        probe="$base"
    else
        local IFS=. a b c d; read -r a b c d <<< "$base"
        d=$((d + 1)); [ "$d" -gt 254 ] && d=1
        probe="$a.$b.$c.$d"
    fi
    route -n get "$probe" 2>/dev/null | awk '/interface:/{print $2; exit}'
}
active_iface() { route -n get default 2>/dev/null | awk '/interface:/{print $2}'; }
active_service() {
    local dev="$1" line svc=""; [ -n "$dev" ] || return 1
    networksetup -listnetworkserviceorder 2>/dev/null | while IFS= read -r line; do
        case "$line" in
            \(*\)\ *) svc="${line#*) }" ;;
            *"Device: $dev)"*) [ -n "$svc" ] && { printf '%s' "$svc"; break; } ;;
        esac
    done
}
manifest_zones() { [ -f "$MANIFEST" ] && cat "$MANIFEST" || true; }
sup_alive() {
    local p; p=$(cat "$SUP_PID" 2>/dev/null | grep -E '^[0-9]+$') || return 1
    [ -n "$p" ] || return 1
    # Тот же расчёт, что и для туннеля: иначе после перезагрузки чужой процесс
    # выдаёт себя за супервизора, launchd молча не стартует, а doctor врёт.
    case "$(ps -p "$p" -o command= 2>/dev/null)" in *"$(basename "$SELF") supervise"*|*"ocbar supervise"*) return 0 ;; *) return 1 ;; esac
}
port53_busy() { nc -z -G 1 127.0.0.1 53 >/dev/null 2>&1; }
services_with_localhost_dns() {
    local svc
    networksetup -listallnetworkservices 2>/dev/null | tail -n +2 | while IFS= read -r svc; do
        case "$svc" in ''|\**) continue ;; esac
        networksetup -getdnsservers "$svc" 2>/dev/null | grep -x '127.0.0.1' >/dev/null && printf '%s\n' "$svc"
    done
}
human_since() { # unix ts → "2ч 13м"
    local s=$(( $(date +%s) - ${1:-0} )); [ "$s" -ge 0 ] || s=0
    if [ $s -ge 3600 ]; then printf '%dч %dм' $((s/3600)) $(((s%3600)/60)); elif [ $s -ge 60 ]; then printf '%dм' $((s/60)); else printf '%dс' $s; fi
}

# --------------------------------------------------------------- секреты ----
kc_get() { security find-generic-password -s "$1" -a "$2" -w 2>/dev/null || true; }
kc_has() { security find-generic-password -s "$1" -a "$2" >/dev/null 2>&1; }

# --- KeePassXC: код берём готовым, TOTP-секрет из базы не достаём вовсе ---
keepassxc_cli() {
    local c
    for c in "${KP_CLI:-}" /Applications/KeePassXC.app/Contents/MacOS/keepassxc-cli \
             /opt/homebrew/bin/keepassxc-cli /usr/local/bin/keepassxc-cli; do
        [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
    done
    return 1
}

keepass_db_path() {
    if [ -n "$P_KP_DB" ]; then printf '%s' "$P_KP_DB"; return 0; fi
    [ -n "${KP_DB:-}" ] && { printf '%s' "$KP_DB"; return 0; }
    return 1
}

# Мастер-пароль базы — из Keychain, в argv не попадает.
# Ловушка `security -w`: значение с не-ASCII байтами отдаётся HEX-строкой без
# каких-либо признаков. Отличить можно только по `-g`: он ставит префикс 0x.
kp_master() {
    local hex
    hex=$(security find-generic-password -g -s "$P_KP_SVC" 2>&1 >/dev/null \
          | sed -n 's/^password: 0x\([0-9A-Fa-f]*\).*/\1/p')
    if [ -n "$hex" ]; then printf '%s' "$hex" | xxd -r -p
    else security find-generic-password -w -s "$P_KP_SVC" 2>/dev/null; fi
}

# Произвольный источник: команда печатает код в stdout. Так подключается любой
# менеджер паролей или аппаратный ключ, не зашитый в этот скрипт.
command_totp() {
    [ -n "$P_TOTP_CMD" ] || { printf 'не задан totp_command в профиле\n' >&2; return 1; }
    local out
    out=$(sh -c "$P_TOTP_CMD" 2>/dev/null | head -1 | tr -d '[:space:]') || {
        printf 'команда totp_command завершилась с ошибкой\n' >&2; return 1; }
    case "$out" in
        [0-9][0-9][0-9][0-9][0-9][0-9]|[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) printf '%s' "$out" ;;
        '') printf 'команда totp_command ничего не вернула\n' >&2; return 1 ;;
        *) printf 'команда totp_command вернула не код из 6-8 цифр\n' >&2; return 1 ;;
    esac
}

# Пароль из KeePassXC. То же, что с кодом (D34): берём готовое значение из
# базы, копию в Keychain не заводим. Значение уходит в stdout и нигде не
# печатается — вызывающий кладёт его сразу в окружение.
keepass_password() {
    local cli db out
    cli=$(keepassxc_cli) || { printf 'нет keepassxc-cli (KeePassXC не установлен?)\n' >&2; return 1; }
    db=$(keepass_db_path) || { printf 'не задан keepass_db в профиле (и нет KP_DB)\n' >&2; return 1; }
    [ -f "$db" ] || { printf 'базы нет: %s\n' "$db" >&2; return 1; }
    [ -n "$P_KP_ENTRY" ] || { printf 'не задан keepass_entry в профиле\n' >&2; return 1; }
    if ! security find-generic-password -s "$P_KP_SVC" >/dev/null 2>&1; then
        printf 'в Keychain нет мастер-пароля базы (сервис %s)\n' "$P_KP_SVC" >&2; return 1
    fi
    out=$(kp_master | "$cli" show -q -a Password "$db" "$P_KP_ENTRY" 2>/dev/null) || {
        printf 'keepassxc-cli не отдал пароль записи «%s»\n' "$P_KP_ENTRY" >&2; return 1
    }
    # Пробелы внутри пароля законны, поэтому режем только перевод строки.
    out=${out%$'\n'}; out=${out%$'\r'}
    [ -n "$out" ] || { printf 'в записи «%s» пустой пароль\n' "$P_KP_ENTRY" >&2; return 1; }
    printf '%s' "$out"
}

# Произвольный источник пароля: команда печатает его первой строкой.
command_password() {
    [ -n "${P_PW_CMD:-}" ] || { printf 'не задан password_command в профиле\n' >&2; return 1; }
    local out
    out=$(sh -c "$P_PW_CMD" 2>/dev/null | head -1) || {
        printf 'команда password_command завершилась с ошибкой\n' >&2; return 1; }
    out=${out%$'\r'}
    [ -n "$out" ] || { printf 'команда password_command ничего не вернула\n' >&2; return 1; }
    printf '%s' "$out"
}

# Откуда взять пароль. Источник один из нескольких, как и у кода: связка
# ключей, база KeePassXC, произвольная команда, «вводит человек».
password_source() {
    local src="${P_PASSWORD:-auto}"
    # auto: заданная команда — значит команда; иначе связка ключей, если
    # пароль там есть; иначе база, если указана запись. Порядок именно такой:
    # у тех, кто держит в KeePassXC только код, пароль остаётся в связке
    # ключей, и «auto» не должен молча увести источник в сторону.
    if [ "$src" = auto ]; then
        if [ -n "${P_PW_CMD:-}" ]; then src=command
        elif kc_has "$P_SVC" "$P_USER"; then src=keychain
        elif [ -n "${P_KP_ENTRY:-}" ]; then src=keepassxc
        else src=keychain; fi
    fi
    printf '%s' "$src"
}

resolve_password() {
    case "$(password_source)" in
        ask)       printf 'источник пароля — человек (password = ask)\n' >&2; return 1 ;;
        keepassxc) keepass_password ;;
        command)   command_password ;;
        *)         local v; v=$(kc_get "$P_SVC" "$P_USER")
                   [ -n "$v" ] || { printf 'в Keychain нет пароля (%s/%s)\n' "$P_SVC" "$P_USER" >&2; return 1; }
                   printf '%s' "$v" ;;
    esac
}

# Печатает готовый одноразовый код или ничего; причина — в stderr.
keepass_totp() {
    local cli db out
    cli=$(keepassxc_cli) || { printf 'нет keepassxc-cli (KeePassXC не установлен?)\n' >&2; return 1; }
    db=$(keepass_db_path) || { printf 'не задан keepass_db в профиле (и нет KP_DB)\n' >&2; return 1; }
    [ -f "$db" ] || { printf 'базы нет: %s\n' "$db" >&2; return 1; }
    [ -n "$P_KP_ENTRY" ] || { printf 'не задан keepass_entry в профиле\n' >&2; return 1; }
    if ! security find-generic-password -s "$P_KP_SVC" >/dev/null 2>&1; then
        printf 'в Keychain нет мастер-пароля базы (сервис %s)\n' "$P_KP_SVC" >&2; return 1
    fi
    # keepassxc-cli читает файл базы напрямую: разблокировать GUI не нужно.
    out=$(kp_master | "$cli" show -q -t "$db" "$P_KP_ENTRY" 2>&1) || {
        printf 'keepassxc-cli не отдал код (%s)\n' "$(printf '%s' "$out" | head -1)" >&2; return 1
    }
    case "$out" in
        [0-9][0-9][0-9][0-9][0-9][0-9]|[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) printf '%s' "$out" ;;
        *) printf 'в записи «%s» нет TOTP\n' "$P_KP_ENTRY" >&2; return 1 ;;
    esac
}

cmd_secret() {
    local what="${1:-}" img="" p=""
    # У import-qr вторым идёт файл, профиль третьим; у остальных — сразу профиль.
    local sel=""
    if [ "$what" = import-qr ]; then
        img="${2:-}"; shift 2 2>/dev/null || true
        # дальше: [профиль] и/или --select <часть имени>
        while [ $# -gt 0 ]; do
            case "$1" in
                --select) sel="${2:-}"; shift 2 ;;
                --list) sel="--list"; shift ;;
                *) p="$1"; shift ;;
            esac
        done
    else
        p="${2:-}"
    fi
    load_profile "$p"
    case "$what" in
        set-password)
            info "Пароль для $P_USER (сервис Keychain: $P_SVC). Ввод спросит security, в argv он не попадёт."
            security add-generic-password -U -s "$P_SVC" -a "$P_USER" -l "ocbar: пароль VPN ($P_USER)" -w
            ok "сохранено" ;;
        set-totp)
            info "TOTP-секрет (base32) для $P_USER (сервис Keychain: $P_SVC)."
            security add-generic-password -U -s "$P_SVC" -a "totp/$P_USER" -l "ocbar: TOTP ($P_USER)" -w
            ok "сохранено" ;;
        import-qr)
            [ -n "$img" ] || die "использование: ocbar secret import-qr <файл-с-QR> [профиль]"
            [ -f "$img" ] || die "нет файла $img"
            local auth; auth=$(auth_path) || die "не найден ocbar-auth"
            if [ "$sel" = "--list" ]; then "$auth" --import-qr "$img" --list; return 0; fi
            local -a sa=(); [ -n "$sel" ] && sa=(--select "$sel")
            info "Читаю QR из $img (секрет не печатается)"
            # Первый проход: метаданные и код для сверки — их человек видит.
            "$auth" --import-qr "$img" "${sa[@]+"${sa[@]}"}" || die "QR не импортирован"
            # Второй: секрет идёт из подпроцесса в security через stdin в
            # interactive-режиме. Через `-w` без значения security при пайпе
            # просит подтверждение и ломается; через argv секрет был бы виден
            # в `ps` любому процессу пользователя.
            local secret; secret=$("$auth" --import-qr "$img" "${sa[@]+"${sa[@]}"}" --print-secret 2>/dev/null)
            [ -n "$secret" ] || die "декодер не вернул секрет"
            if printf 'add-generic-password -U -s %s -a %s -l %s -w %s\n' \
                   "$P_SVC" "totp/$P_USER" "ocbar-TOTP-$P_USER" "$secret" | security -i >/dev/null 2>&1; then
                ok "секрет сохранён в Keychain ($P_SVC / totp/$P_USER)"
            else
                secret=""; die "не удалось сохранить в Keychain"
            fi
            secret=""
            # Сверка: код, посчитанный из того, что реально легло в Keychain.
            local kc_code; kc_code=$(OCBAR_TOTP_SECRET="$(kc_get "$P_SVC" "totp/$P_USER")" "$auth" --totp-now 2>/dev/null)
            [ -n "$kc_code" ] && ok "код из Keychain" "$kc_code — должен совпасть с показанным выше и с приложением"
            info ""
            info "Сверьте код с приложением. Совпал — включайте автоввод:"
            info "  в $PROFILES у профиля [$P_NAME] замените 'totp = off' на 'totp = auto'"
            info "Файл с QR лучше удалить: rm -P \"$img\""
            ;;
        status|'')
            local psrc; psrc=$(password_source)
            case "$psrc" in
                keychain)
                    if kc_has "$P_SVC" "$P_USER"; then ok "пароль" "из Keychain ($P_SVC / $P_USER)"
                    else warn "пароль" "источник Keychain, но пароля там нет — ocbar secret set-password $P_NAME"; fi ;;
                ask) warn "пароль" "вводит человек (password = ask)" ;;
                keepassxc|command)
                    local perr; perr=$(mktemp "${TMPDIR:-/tmp}/ocbar-pw.XXXXXX")
                    # Значение не печатаем никогда — только факт, что оно есть.
                    if [ -n "$(resolve_password 2>"$perr")" ]; then
                        ok "пароль" "$([ "$psrc" = keepassxc ] && echo "из KeePassXC: $P_KP_ENTRY" || echo "из команды password_command")"
                    else
                        bad "пароль" "$psrc — $(head -1 "$perr" 2>/dev/null)"
                    fi
                    rm -f "$perr" ;;
            esac
            # При источнике KeePassXC секрета в Keychain быть и не должно —
            # советовать его завести значит звать копировать секрет второй раз.
            if kc_has "$P_SVC" "totp/$P_USER"; then
                if [ "$P_TOTP" = keepassxc ]; then
                    warn "TOTP-секрет" "лежит в Keychain, хотя источник — KeePassXC: лишняя копия"
                else
                    ok "TOTP-секрет" "есть ($P_SVC / totp/$P_USER)"
                fi
            elif [ "$P_TOTP" = keepassxc ]; then
                skip "TOTP-секрет" "в Keychain не хранится — источник KeePassXC"
            else
                skip "TOTP-секрет" "нет — ocbar secret set-totp $P_NAME (если IdP просит код)"
            fi
            case "$P_TOTP" in
                off) warn "Автоввод TOTP" "выключен (totp = off) — код вводит человек" ;;
                keepassxc|command)
                    local c err src; err=$(mktemp "${TMPDIR:-/tmp}/ocbar-totp.XXXXXX")
                    if [ "$P_TOTP" = keepassxc ]; then c=$(keepass_totp 2>"$err") || true; src="KeePassXC: $P_KP_ENTRY"
                    else c=$(command_totp 2>"$err") || true; src="команда totp_command"; fi
                    if [ -n "$c" ]; then ok "Автоввод TOTP" "из $src (код сейчас $c)"
                    else bad "Автоввод TOTP" "$src — $(head -1 "$err" 2>/dev/null)"; fi
                    rm -f "$err" ;;
                *)  if kc_has "$P_SVC" "totp/$P_USER"; then ok "Автоввод TOTP" "из Keychain, один раз за вход"; else skip "Автоввод TOTP" "включён, но секрета нет"; fi ;;
            esac ;;
        *) die "secret: set-password | set-totp | import-qr <файл> | status [профиль]" ;;
    esac
}

# --------------------------------------------------------------- connect ----
# Аутентификация → JSON от ocbar-auth. Секреты — только через окружение.
authenticate() { # печатает "token hash post_url"
    local auth; auth=$(auth_path) || die "не найден ocbar-auth — собрать: (cd auth && swift build -c release)"
    local -a args=(--url "$P_URL" --useragent "$P_UA")
    # Молчаливый режим для автоподключения: окно поверх работы человека без
    # спроса — плохо. Если вход требует участия, выходим с кодом 5, а решение
    # принимает человек.
    [ "${OCBAR_SILENT:-}" = 1 ] && args+=(--no-window --timeout "${OCBAR_SILENT_TIMEOUT:-25}")
    [ -n "$P_RULES" ] && [ -f "$P_RULES" ] && args+=(--rules "$P_RULES")
    [ -n "$P_FILL_HOSTS" ] && args+=(--fill-hosts "$P_FILL_HOSTS")
    [ "${OCBAR_SHOW:-}" = 1 ] && args+=(--always-show)
    [ "${OCBAR_VERBOSE:-}" = 1 ] && args+=(--verbose)
    local pw totp="" code="" pwerr; pwerr=$(mktemp "${TMPDIR:-/tmp}/ocbar-pw.XXXXXX")
    pw=$(resolve_password 2>"$pwerr") || true
    case "$P_TOTP" in
        off) ;;
        keepassxc)
            # Из базы приходит готовый код, а не секрет: секрет остаётся в базе.
            code=$(keepass_totp) || log "код из KeePassXC не получен — введёт человек" ;;
        command)
            code=$(command_totp) || log "код от totp_command не получен — введёт человек" ;;
        *)   totp=$(kc_get "$P_SVC" "totp/$P_USER") ;;
    esac
    [ -n "$pw" ] || log "пароль не получен (источник $(password_source): $(head -1 "$pwerr" 2>/dev/null)) — форму заполнит человек"
    rm -f "$pwerr"
    local json
    json=$(OCBAR_USERNAME="$P_USER" OCBAR_PASSWORD="$pw" OCBAR_TOTP_SECRET="$totp" \
           OCBAR_TOTP_CODE="$code" "$auth" "${args[@]}") || {
        local rc=$?
        case $rc in
            2) die "SSO: тайм-аут" ;;
            3) die "SSO: окно закрыто" ;;
            5) printf '%socbar: молча войти не удалось — сессия требует человека%s\n' "$c_yel" "$c_off" >&2
               return 5 ;;
            *) die "SSO: ошибка ($rc)" ;;
        esac
    }
    printf '%s' "$json" | /usr/bin/python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["session_token"], d["server_cert_hash"], d["post_url"])'
}

build_spec() { # cookie → stdin для tunnel-start
    printf 'cookie=%s\n' "$1"
    active_networks | sed 's/^/net /'
    active_zones    | sed 's/^/zone /'
}

do_connect() { # профиль уже загружен
    if [ "${P_KIND:-tunnel}" = proxy ]; then
        die "профиль [$P_NAME] просит прокси-режим (Mode = proxy), а он ещё не реализован: нужна вторая ветка запуска — openconnect --script-tun и ocproxy (docs/09-proxy-mode.md). Уберите ключ, чтобы подключаться туннелем."
    fi
    if [ "$P_AUTH" = password ]; then
        die "профиль [$P_NAME] — парольная группа (auth = password): шлюз ждёт логин/пароль и OTP из SMS, ocbar этого не автоматизирует. Подключайся голым openconnect (см. README)."
    fi
    case "$(tunnel_state)" in
        connected) info "уже подключён (pid $(tunnel_pid), $(env_get TUNDEV))"; return 0 ;;
        starting)  die "openconnect уже запускается (pid $(tunnel_pid)) — подожди или ocbar disconnect" ;;
    esac
    # Хвосты от прошлой сессии — убрать до подключения.
    if [ "$(env_get STATE)" = connected ] || [ -s "$ROUTES_STATE" ] || [ "$(manifest_zones | grep -c .)" -gt 0 ]; then
        info "остались следы прошлой сессии — убираю"
        priv cleanup
    fi
    if [ "$DRY_RUN" = 1 ]; then
        info "[dry-run] аутентификация пропущена; подключение выглядело бы так:"
        build_spec "COOKIE" | sed 's/^cookie=.*/cookie=***/' | sed 's/^/    /'
        build_spec "COOKIE" | priv tunnel-start "$P_URL" "0000000000000000000000000000000000000000" "$P_MODE" "$P_USER" "$P_UA" "${P_CSD:+$(basename "$P_CSD")}"
        return 0
    fi
    info "Вход через SSO: $P_TITLE ($P_URL)…"
    local token hash post_url out rc=0
    out=$(authenticate) || rc=$?
    # 5 — «нужен человек»: не ошибка, а решение, которое принимает не скрипт.
    [ "$rc" = 5 ] && return 5
    [ "$rc" = 0 ] || return "$rc"
    read -r token hash post_url <<< "$out"
    [ -n "$token" ] || die "аутентификация не вернула токен"
    # КРИТИЧНО: подключаться надо к тому узлу, что выдал cookie. Балансировщик
    # увёл SSO на конкретный узел (post_url), и session-token/servercert — его.
    # Исходный vpn.example.com балансировщик отправит на другой узел, и тот
    # ответит 401 «cookie не моя». Поэтому туннель — на post_url.
    local connect_url="${post_url:-$P_URL}"
    [ "$connect_url" = "$P_URL" ] || info "балансировщик увёл на $connect_url — туннель туда же"
    info "сессия получена, поднимаю туннель ($P_MODE)…"
    build_spec "$token" | priv tunnel-start "$connect_url" "$hash" "$P_MODE" "$P_USER" "$P_UA" "${P_CSD:+$(basename "$P_CSD")}"
    local i=0
    while [ $i -lt 40 ]; do
        [ "$(tunnel_state)" = connected ] && break
        tunnel_alive || { [ $i -gt 3 ] && die "openconnect умер при старте — хвост $OC_LOG:"$'\n'"$(tail -5 "$OC_LOG" 2>/dev/null)"; }
        sleep 1; i=$((i+1))
    done
    [ "$(tunnel_state)" = connected ] || die "туннель не поднялся за 40 с (STATE=$(env_get STATE)), см. $OC_LOG"
    log "подключён: $P_NAME → $(env_get TUNDEV) $(env_get IP4)"
    mkdir -p "$USER_STATE"; printf '%s\n' "$P_NAME" > "$DESIRED"
    rm -f "$NEEDS_LOGIN" "$LINK_LOST" 2>/dev/null || true
    notify "ocbar: подключено" "$P_TITLE · $(env_get TUNDEV) · $(env_get IP4)"
    report_health || true
}

# Проверка после подключения: поднятый интерфейс и работающий доступ — разные
# вещи. Формат в профиле: URL, «хост:порт» или просто имя (тогда проверяется,
# что оно резолвится через наши зоны).
healthcheck() {
    [ -n "${P_HEALTH:-}" ] || return 0
    case "$P_HEALTH" in
        http://*|https://*) curl -s -o /dev/null --max-time 8 "$P_HEALTH" ;;
        *:[0-9]*)           nc -z -w 5 "${P_HEALTH%:*}" "${P_HEALTH##*:}" >/dev/null 2>&1 ;;
        *)                  [ -n "$(dscacheutil -q host -a name "$P_HEALTH" 2>/dev/null | awk '/^ip_address/{print $2; exit}')" ] ;;
    esac
}

report_health() {   # печатает и уведомляет; не роняет подключение
    [ -n "${P_HEALTH:-}" ] || return 0
    if healthcheck; then
        ok "Проверка доступа" "$P_HEALTH отвечает"
        log "проверка после подключения: $P_HEALTH отвечает"
    else
        warn "Проверка доступа" "$P_HEALTH НЕ отвечает — туннель поднят, но доступа нет"
        log "проверка после подключения: $P_HEALTH не отвечает"
        notify "ocbar: доступа нет" "Туннель поднят, но $P_HEALTH не отвечает"
        return 1
    fi
}

cmd_connect() {
    # Явный вызов человеком — это и есть его решение: снимаем ожидание.
    rm -f "$NEEDS_LOGIN" 2>/dev/null || true
    local p="" a
    for a in "$@"; do case "$a" in --show) OCBAR_SHOW=1 ;; -v|--verbose) OCBAR_VERBOSE=1 ;; *) p="$a" ;; esac; done
    load_profile "$p"
    do_connect
    [ "$DRY_RUN" = 1 ] || cmd_status
}

cmd_disconnect() {
    rm -f "$DESIRED" "$LINK_LOST" 2>/dev/null || true
    if ! tunnel_alive && [ "$(env_get STATE)" != connected ] && [ ! -s "$ROUTES_STATE" ] && [ "$(manifest_zones | grep -c .)" = 0 ]; then
        info "не подключён"; return 0
    fi
    priv tunnel-stop
    log "отключён"
    info "отключён"
}

# ---------------------------------------------------------------- status ----
cmd_status() {
    local short=0; [ "${1:-}" = "--short" ] && short=1
    # Сети и зоны живут в профиле, поэтому для показа его надо загрузить.
    # Молча: отсутствие профиля — не повод рушить показ состояния.
    if [ -z "${P_FILE:-}" ]; then
        # Сначала выбранный профиль, при неудаче — умолчание: если в состоянии
        # осталось имя удалённого профиля, показ состояния из-за этого страдать
        # не должен.
        local want; want=$(cat "$DESIRED" 2>/dev/null || true)
        try_load_profile "$want" || try_load_profile "$(profile_default)" || true
    fi
    local st; st=$(tunnel_state)
    local prof; prof=$(cat "$DESIRED" 2>/dev/null || true)
    local dev ip since gw dns url mode
    dev=$(env_get TUNDEV); ip=$(env_get IP4); since=$(env_get CONNECTED); gw=$(env_get GATEWAY); dns=$(env_get DNS); url=$(env_get URL); mode=$(env_get MODE)
    local foreign=""; if [ "$st" = down ] && pgrep -x openconnect >/dev/null 2>&1; then foreign=1; fi

    if [ "$short" = 1 ]; then
        printf 'paused=%s\nneeds_login=%s\n' "$(is_paused && echo 1 || echo 0)" "$([ -f "$NEEDS_LOGIN" ] && echo 1 || echo 0)"
        # Потеря связи — состояние живого туннеля, о котором знает только
        # супервизор. Без него отметка устаревает мгновенно (он же её и
        # снимает), поэтому мёртвый супервизор её не показывает.
        if [ "$st" = connected ] && [ -f "$LINK_LOST" ] && sup_alive; then
            printf 'link_lost=%s\n' "$(cat "$LINK_LOST" 2>/dev/null)"
        fi
        printf 'state=%s\nprofile=%s\ntundev=%s\nip=%s\nsince=%s\ngateway=%s\ndns=%s\nurl=%s\nmode=%s\nforeign=%s\nsupervisor=%s\niface=%s\n' \
            "$st" "$prof" "$dev" "$ip" "$since" "$gw" "$dns" "$url" "$mode" "$foreign" "$(sup_alive && echo 1 || echo 0)" "$(active_iface)"
        local n z
        while read -r n; do
            [ -n "$n" ] || continue
            # Плейсхолдер обязателен: пустое поле схлопывается при разборе, и
            # меню принимает признак «включено» за имя интерфейса.
            printf 'route=%s %s %s\n' "$n" "$(route_via "$n" || true)" "$(is_off "$n" "$ROUTES_OFF" && echo off || echo on)" \
                | sed 's/  / - /'
        done <<< "$(read_networks)"
        while read -r z d p; do [ -n "$z" ] || continue; printf 'zone=%s %s %s %s\n' "$z" "$d" "$(manifest_zones | grep -Fxq "$z" && echo applied || echo -)" "$(is_off "$z" "$ZONES_OFF" && echo off || echo on)"; done <<< "$(read_zones)"
        # Режим выбранного профиля: приложение показывает его в меню и не даёт
        # подключиться профилем, который просит нереализованный режим.
        printf 'profile_mode=%s\nproxy_port=%s\nsystem_proxy=%s\n' \
            "${P_KIND:-tunnel}" "${P_PROXY_PORT:-11080}" "${P_SYS_PROXY:-off}"
        profiles_summary | while IFS= read -r line; do [ -n "$line" ] && printf 'profile_list=%s\n' "$line"; done
        printf 'default=%s\n' "$(profile_default)"
        return 0
    fi

    case "$st" in
        connected) ok "Туннель" "$dev · $ip · $(human_since "$since") · $mode" ;;
        paused)    warn "Туннель" "на паузе: поднят ($dev, $(human_since "$since")), но маршруты и зоны сняты — ocbar resume" ;;
        starting)  warn "Туннель" "openconnect запускается (pid $(tunnel_pid))" ;;
        down)      if [ -n "$foreign" ]; then warn "Туннель" "не наш: работает чужой openconnect (pid $(pgrep -x openconnect | head -1))"; else skip "Туннель" "не поднят"; fi ;;
    esac
    [ -n "$prof" ] && ok "Профиль" "$prof$( [ -n "$url" ] && printf ' (%s)' "$url")" || skip "Профиль" "не выбран"
    [ -n "$gw" ] && ok "Шлюз" "$gw · DNS от шлюза: ${dns:-нет}"
    ok "Сеть" "$(active_service "$(active_iface)" 2>/dev/null || echo ?) ($(active_iface))"
    local n via line=""
    while read -r n; do
        [ -n "$n" ] || continue
        via=$(route_via "$n")
        if is_off "$n" "$ROUTES_OFF"; then line="$line ${c_dim}${n}(выкл)${c_off}"
        elif [ -n "$via" ] && [ "$via" = "$dev" ]; then line="$line ${c_grn}${n}${c_off}"
        elif [ -n "$via" ]; then line="$line ${c_yel}${n}→${via}${c_off}"
        else line="$line ${c_dim}${n}(нет)${c_off}"; fi
    done <<< "$(read_networks)"
    [ -n "$line" ] && ok "Маршруты" "$line" || skip "Маршруты" "networks.conf пуст"
    local zc; zc=$(manifest_zones | grep -c . || true)
    [ "$zc" -gt 0 ] && ok "Зоны /etc/resolver" "$zc наших: $(manifest_zones | tr '\n' ' ')" || skip "Зоны /etc/resolver" "наших нет"
    sup_alive && ok "Супервизор" "работает (pid $(cat "$SUP_PID"))" || skip "Супервизор" "не запущен"
    if [ "$st" = connected ] && [ -f "$LINK_LOST" ] && sup_alive; then
        warn "Связь" "не отвечает $(( $(date +%s) - $(cat "$LINK_LOST") )) с — openconnect восстанавливает сессию сам"
    fi
    [ -f "$NEEDS_LOGIN" ] && warn "Автоподключение" "остановлено: нужен вход — ocbar connect"
}

# ---------------------------------------------------------------- routes ----
cmd_routes() {
    local sub="${1:-status}" n
    case "$sub" in
        status) cmd_status ;;
        add|on)
            valid_cidr "${2:-}" || die "routes add <CIDR>"
            mkdir -p "$USER_STATE"; [ -f "$ROUTES_OFF" ] && { grep -vx "$2" "$ROUTES_OFF" > "$ROUTES_OFF.tmp" || true; mv "$ROUTES_OFF.tmp" "$ROUTES_OFF"; }
            case "$(tunnel_state)" in
                connected|paused) priv route-add "$2" ;;
                *) info "$2 включена; применится при подключении" ;;
            esac ;;
        del|off)
            valid_cidr "${2:-}" || die "routes del <CIDR>"
            mkdir -p "$USER_STATE"; read_networks | grep -Fxq "$2" && { is_off "$2" "$ROUTES_OFF" || printf '%s\n' "$2" >> "$ROUTES_OFF"; }
            case "$(tunnel_state)" in
                connected|paused) priv route-del "$2" ;;
                *) info "$2 выключена" ;;
            esac ;;
        toggle)
            valid_cidr "${2:-}" || die "routes toggle <CIDR>"
            if is_off "$2" "$ROUTES_OFF"; then cmd_routes add "$2"; else cmd_routes del "$2"; fi ;;
        apply)
            [ "$(tunnel_state)" = connected ] || die "туннель не поднят"
            while read -r n; do [ -n "$n" ] && priv route-add "$n"; done <<< "$(active_networks)" ;;
        clear)
            while read -r n; do [ -n "$n" ] && priv route-del "$n"; done <<< "$(read_networks)" ;;
        *) die "routes: status | add <CIDR> | del <CIDR> | toggle <CIDR> | apply | clear" ;;
    esac
}

# ------------------------------------------------------------------- dns ----
cmd_dns_status() {
    info "Зоны в $RESOLVER_DIR"
    local found=0 f z
    for f in "$RESOLVER_DIR"/*; do
        [ -e "$f" ] || continue; z=$(basename "$f"); found=1
        if manifest_zones | grep -Fxq "$z"; then printf '  %s %s %s(наша)%s\n' "$(pad "$z" 32)" "$(tr '\n' ' ' < "$f")" "$c_dim" "$c_off"
        else printf '  %s %s %s(чужая, не трогаем)%s\n' "$(pad "$z" 32)" "$(tr '\n' ' ' < "$f")" "$c_dim" "$c_off"; fi
    done
    [ "$found" = 1 ] || skip "пусто"
    info ""; info "Как это видит система (scutil --dns)"
    scutil --dns 2>/dev/null | awk '/^resolver #/{d="";n=""} /domain *:/{d=$3} /nameserver\[0\]/{n=$3} d!="" && n!="" {printf "  %-32s %s\n", d, n; d="";n=""}' | sort -u
}
cmd_dns_apply() {
    local zones; zones=$(active_zones); [ -n "$zones" ] || die "в $ZONES_CONF нет ни одной активной зоны"
    local vpndns; vpndns=$(env_get DNS); vpndns="${vpndns%% *}"
    zones=$(printf '%s\n' "$zones" | awk -v d="$vpndns" '$2=="vpn" { if (d=="") { print "zone " $1 " ждёт DNS от шлюза — туннель не поднят" > "/dev/stderr"; next } $2=d } {print}')
    [ -n "$zones" ] || die "все зоны ждут DNS от шлюза (vpn), а туннель не поднят"
    info "Применяю зоны из $ZONES_CONF"
    printf '%s\n' "$zones" | priv dns-apply
}
cmd_dns_init() {
    local src="${1:-}" dns="${2:-}"
    [ -n "$src" ] && [ -n "$dns" ] || die "использование: ocbar dns init <файл-со-списком-доменов> <DNS|vpn>"
    [ -f "$src" ] || die "нет файла $src"
    [ "$dns" = vpn ] || valid_ip "$dns" || die "не похоже на адрес: $dns"
    mkdir -p "$CONFIG_DIR"; [ -f "$ZONES_CONF" ] && die "конфиг уже есть: $ZONES_CONF (правьте руками)"
    { echo "# ocbar: зона → DNS [порт]. Более длинная зона перебивает короткую."
      echo "# 'vpn' вместо адреса = DNS, который прислал шлюз."; echo
      local d; while read -r d _; do case "${d:-}" in ''|\#*) continue ;; esac; d=$(printf '%s' "$d" | tr -d '[:space:]'); valid_zone "$d" && printf '%s %s\n' "$(pad "$d" 32)" "$dns"; done < "$src"
    } > "$ZONES_CONF"
    ok "создан $ZONES_CONF"; cat "$ZONES_CONF"
}
cmd_dns() {
    case "${1:-status}" in
        status) cmd_dns_status ;;
        apply)  cmd_dns_apply ;;
        clear)  priv dns-clear ;;
        init)   cmd_dns_init "${2:-}" "${3:-}" ;;
        on|add)
            valid_zone "${2:-}" || die "dns on <зона>"
            mkdir -p "$USER_STATE"
            [ -f "$ZONES_OFF" ] && { grep -Fvx "$2" "$ZONES_OFF" > "$ZONES_OFF.tmp" || true; mv "$ZONES_OFF.tmp" "$ZONES_OFF"; }
            local zl; zl=$(read_zones | awk -v z="$2" '$1==z {print $2, $3; exit}')
            case "$(tunnel_state)" in
                connected|paused) priv zone-add "$2" ${zl:-vpn 53} ;;
                *) info "$2 включена; применится при подключении" ;;
            esac ;;
        off|del)
            valid_zone "${2:-}" || die "dns off <зона>"
            mkdir -p "$USER_STATE"
            is_off "$2" "$ZONES_OFF" || printf '%s\n' "$2" >> "$ZONES_OFF"
            case "$(tunnel_state)" in
                connected|paused) priv zone-del "$2" ;;
                *) info "$2 выключена" ;;
            esac ;;
        toggle)  valid_zone "${2:-}" || die "dns toggle <зона>"; if is_off "$2" "$ZONES_OFF"; then cmd_dns on "$2"; else cmd_dns off "$2"; fi ;;
        *) die "dns: status | apply | clear | init <файл> <DNS|vpn> | on|off|toggle <зона>" ;;
    esac
}

# -------------------------------------------------------------- profiles ----
cmd_profiles() {
    [ -n "$(profile_list)" ] || die "профилей нет: положите файл в $PROFILE_DIR (образец etc/example.ocbar) или заполните $PROFILES"
    local d p nm au ds; d=$(profile_default)
    while IFS='|' read -r p nm au ds; do
        [ -n "$p" ] || continue
        case "$au" in password) au="(пароль+OTP, не SSO)" ;; esac
        local url f; f=$(profile_file "$p")
        if [ -n "$f" ]; then url=$(pf_get "$f" Connection Url); else url=$(profile_get "$p" url); fi
        printf '  %s %s %s %s  %s\n' "$([ "$p" = "$d" ] && echo '*' || echo ' ')" \
            "$(pad "$p" 18)" "$(pad "$nm" 20)" "$url" "$au"
        [ -n "$ds" ] && printf '      %s%s%s\n' "$c_dim" "$ds" "$c_off"
    done <<< "$(profiles_summary)"
}

# ------------------------------------------------------------- песочница ----
# Отдельная страница, где интерфейс смотрится во всех состояниях: подключено,
# пауза, потеря связи, ожидание входа, отключено. С --live подкладывает снимок
# реального состояния, поэтому видно настоящие адреса, сети и счётчики.
cmd_ui_lab() {
    local lab live=0 a
    for a in "$@"; do case "$a" in --live) live=1 ;; esac; done
    for c in "$SELF_DIR/../tools/ui-lab/index.html" "$SELF_DIR/../share/ocbar/ui-lab/index.html"; do
        [ -f "$c" ] && { lab="$(cd "$(dirname "$c")" && pwd)/index.html"; break; }
    done
    [ -n "${lab:-}" ] || die "не нашёл страницу песочницы (tools/ui-lab/index.html)"
    local dir; dir=$(dirname "$lab")
    if [ "$live" = 1 ]; then
        ui_lab_snapshot > "$dir/state.json" && ok "снимок состояния" "$dir/state.json"
    else
        rm -f "$dir/state.json" 2>/dev/null || true
    fi
    info "открываю $lab"
    open "$lab"
}

# Снимок в JSON: ровно те поля, которые рисует страница.
ui_lab_snapshot() {
    local dev ip gw mtu dns since rx tx lat prof
    prof=$(cat "$DESIRED" 2>/dev/null || profile_default)
    dev=$(env_get TUNDEV); ip=$(env_get IP4); gw=$(env_get GATEWAY)
    mtu=$(env_get MTU); dns=$(env_get DNS); since=$(env_get CONNECTED)
    if [ -n "$dev" ]; then
        # Счётчики читаются с конца строки: колонки адреса у utun нет,
        # и позиционный разбор смещается.
        read -r rx tx <<< "$(netstat -ib -I "$dev" 2>/dev/null | awk 'NR==2{printf "%.1f %.1f", $(NF-4)/1048576, $(NF-1)/1048576}')"
    fi
    lat=$(ping -c 1 -W 900 "${gw:-127.0.0.1}" 2>/dev/null | awk -F'time=' '/time=/{print int($2)" мс"; exit}')
    printf '{\n'
    printf '  "profile": "%s",\n' "${prof:-—}"
    printf '  "tundev": "%s",\n' "${dev:-—}"
    printf '  "ip": "%s",\n' "${ip:-—}"
    printf '  "gateway": "%s",\n' "${gw:-—}"
    printf '  "mtu": "%s",\n' "${mtu:-—}"
    printf '  "dns": "%s",\n' "${dns:-—}"
    printf '  "since": "%s",\n' "$( [ -n "$since" ] && human_since "$since" || echo '—')"
    printf '  "rx": "%s МБ",\n' "${rx:-0}"
    printf '  "tx": "%s МБ",\n' "${tx:-0}"
    printf '  "latency": "%s",\n' "${lat:-нет ответа}"
    printf '  "zones": %s,\n' "$(manifest_zones | grep -c . || true)"
    printf '  "routes": ['
    local first=1 n via
    while read -r n; do
        [ -n "$n" ] || continue
        via=$(route_via "$n")
        [ "$first" = 1 ] || printf ', '
        printf '["%s", %s]' "$n" "$( [ "$via" = "$dev" ] && echo true || echo false)"
        first=0
    done <<< "$(read_networks 2>/dev/null)"
    printf ']\n}\n'
}

# ------------------------------------------------------- импорт/экспорт ----
cmd_import() {
    local src="${1:-}" name="${2:-}"
    [ -n "$src" ] || die "использование: ocbar import <файл.ocbar> [имя]"
    [ -f "$src" ] || die "нет файла $src"
    local url; url=$(pf_get "$src" Connection Url)
    [ -n "$url" ] || die "это не похоже на профиль ocbar: в [Connection] нет Url"
    [ -n "$name" ] || { name=$(basename "$src"); name="${name%.ocbar}"; name="${name%.conf}"; }
    valid_name_soft "$name" || die "имя профиля может содержать буквы, цифры, дефис и точку: $name"
    mkdir -p "$PROFILE_DIR"
    local dst="$PROFILE_DIR/$name.ocbar"
    [ -f "$dst" ] && die "профиль [$name] уже есть: $dst (удалите или укажите другое имя)"
    cp "$src" "$dst"; chmod 600 "$dst"
    ok "профиль [$name] импортирован" "$dst"
    info ""
    if try_load_profile "$name"; then
        info "  подключение: $P_URL"
        info "  сетей в туннель: $(read_networks 2>/dev/null | grep -c . || true), зон DNS: $(read_zones 2>/dev/null | grep -c . || true)"
        info "  код второго фактора: $P_TOTP"
    else
        warn "профиль импортирован, но прочитать его целиком не удалось"
    fi
}

# Экспорт годится и как миграция: старый профиль из profiles.conf вместе с
# общими networks.conf и zones.conf собирается в один самодостаточный файл.
cmd_export() {
    local p="${1:-}" out="${2:-}"
    load_profile "$p"
    # Каждая необязательная строка — через if, а не через `[ ] && printf`:
    # ложное условие в конце подстановки завершает её с ошибкой, и при set -e
    # экспорт молча возвращает пустоту.
    local body; body=$(
        printf '# Профиль ocbar, выгружен %s\n\n' "$(date '+%Y-%m-%d')"
        printf '[Connection]\n'
        printf 'Name        = %s\n' "$P_TITLE"
        if [ -n "${P_DESCR:-}" ]; then printf 'Description = %s\n' "$P_DESCR"; fi
        printf 'Url         = %s\n' "$P_URL"
        printf 'User        = %s\n' "$P_USER"
        printf 'UserAgent   = %s\n' "$P_UA"
        if [ -n "${P_CSD:-}" ]; then printf 'CsdWrapper  = %s\n' "$P_CSD"; fi
        if [ "${P_AUTH:-sso}" != sso ]; then printf 'Auth        = %s\n' "$P_AUTH"; fi
        if [ "${P_KIND:-tunnel}" != tunnel ]; then printf 'Mode        = %s\n' "$P_KIND"; fi
        if [ "${P_KIND:-tunnel}" != tunnel ] || [ "${P_SYS_PROXY:-off}" != off ]; then
            printf '\n[Proxy]\nPort         = %s\nSystemProxy  = %s\n' "${P_PROXY_PORT:-11080}" "${P_SYS_PROXY:-off}"
        fi
        printf '\n[Routes]\n'
        read_networks 2>/dev/null | while read -r n _; do
            if [ -n "$n" ]; then printf '%s\n' "$n"; fi
        done
        printf '\n[DNS]\n'
        read_zones 2>/dev/null | while read -r z d pt; do
            if [ -n "$z" ]; then
                if [ "${pt:-53}" = 53 ]; then printf '%-24s = %s\n' "$z" "$d"
                else printf '%-24s = %s %s\n' "$z" "$d" "$pt"; fi
            fi
        done
        printf '\n[Auth]\n'
        if [ "${P_PASSWORD:-keychain}" != keychain ]; then printf 'Password        = %s\n' "$P_PASSWORD"; fi
        if [ -n "${P_PW_CMD:-}" ]; then printf 'PasswordCommand = %s\n' "$P_PW_CMD"; fi
        printf 'Totp            = %s\n' "${P_TOTP:-auto}"
        if [ -n "${P_TOTP_CMD:-}" ];   then printf 'TotpCommand     = %s\n' "$P_TOTP_CMD"; fi
        if [ -n "${P_KP_ENTRY:-}" ];   then printf 'KeepassEntry    = %s\n' "$P_KP_ENTRY"; fi
        if [ -n "${P_KP_DB:-}" ];      then printf 'KeepassDb       = %s\n' "$P_KP_DB"; fi
        if [ -n "${P_KP_SVC:-}" ];     then printf 'KeepassKeychain = %s\n' "$P_KP_SVC"; fi
        if [ -n "${P_SVC:-}" ];        then printf 'KeychainService = %s\n' "$P_SVC"; fi
        if [ -n "${P_FILL_HOSTS:-}" ]; then printf 'IdpHosts        = %s\n' "$P_FILL_HOSTS"; fi
        if [ -n "${P_HEALTH:-}" ]; then printf '\n[Health]\nCheck = %s\n' "$P_HEALTH"; fi
        true
    )
    if [ -n "$out" ]; then
        printf '%s\n' "$body" > "$out"; chmod 600 "$out"
        ok "профиль [$P_NAME] выгружен" "$out"
        info "  секретов в файле нет — можно передавать"
    else
        printf '%s\n' "$body"
    fi
}

valid_name_soft() { local re='^[A-Za-z0-9][A-Za-z0-9._-]*$'; [[ $1 =~ $re ]]; }

# ---------------------------------------------------------------- doctor ----
cmd_doctor() {
    local issues=0 oc h
    info "ocbar doctor"; info "========================================"
    ok "Платформа" "$(sw_vers -productVersion 2>/dev/null || uname -r) $(uname -m)"
    if oc=$(openconnect_bin); then ok "openconnect (brew)" "$oc ($("$oc" --version 2>&1 | head -1 | awk '{print $3}'))"; else bad "openconnect" "не найден — brew install openconnect"; issues=$((issues+1)); fi
    if [ -x "$LIBDIR/openconnect" ]; then ok "openconnect (root-копия)" "$LIBDIR/openconnect"; else warn "openconnect (root-копия)" "нет — sudo ocbar install"; fi
    if [ -f "$PREFIX/etc/ocbar/trust.sha256" ]; then
        if shasum -a 256 -c --status "$PREFIX/etc/ocbar/trust.sha256" 2>/dev/null; then ok "Манифест доверия" "$(grep -c . "$PREFIX/etc/ocbar/trust.sha256") файлов, хеши совпадают"
        else bad "Манифест доверия" "хеши НЕ совпадают — после brew upgrade: sudo ocbar install --trust"; issues=$((issues+1)); fi
    else warn "Манифест доверия" "нет — sudo ocbar install"; fi
    if h=$(auth_path); then ok "ocbar-auth" "$h"; else bad "ocbar-auth" "не найден"; issues=$((issues+1)); fi
    if [ -x "$HELPER_INSTALLED" ]; then
        local own; own=$(stat -f '%Su:%Sg %Lp' "$HELPER_INSTALLED")
        if [ "$own" = "root:wheel 755" ]; then ok "ocbar-helper" "$HELPER_INSTALLED ($own)"; else bad "ocbar-helper" "$HELPER_INSTALLED — $own, должно быть root:wheel 755"; issues=$((issues+1)); fi
        if helper_nopasswd; then ok "sudoers" "NOPASSWD на хелпер есть"; else warn "sudoers" "нет NOPASSWD — из меню/супервизора не сработает: sudo ocbar install"; fi
        if helper_supports_pause; then ok "Версия хелпера" "$("$HELPER_INSTALLED" version 2>/dev/null | awk '{print $2}') — умеет pause/resume"
        else warn "Версия хелпера" "$("$HELPER_INSTALLED" version 2>/dev/null | awk '{print $2}') старее CLI: sudo ocbar install"; fi
    elif h=$(helper_path); then warn "ocbar-helper" "не установлен, есть только $h (sudo спросит пароль)"
    else bad "ocbar-helper" "не найден"; issues=$((issues+1)); fi
    if [ -f "$PROFILES" ]; then ok "Профили" "$(profile_list | wc -l | tr -d ' ') в $PROFILES, default=$(profile_default)"; else warn "Профили" "нет $PROFILES — см. etc/profiles.conf.example"; fi
    [ -f "$ZONES_CONF" ] && ok "zones.conf" "$(read_zones 2>/dev/null | wc -l | tr -d ' ') зон" || warn "zones.conf" "нет — ocbar dns init"
    [ -f "$NETWORKS_CONF" ] && ok "networks.conf" "$(read_networks 2>/dev/null | tr '\n' ' ')" || warn "networks.conf" "нет — см. etc/networks.conf.example"
    if [ -f "$AGENT_PLIST" ]; then
        if launchctl print "gui/$(id -u)/$AGENT_LABEL" >/dev/null 2>&1; then ok "LaunchAgent" "$AGENT_LABEL загружен"; else warn "LaunchAgent" "plist есть, но не загружен: launchctl bootstrap gui/$(id -u) $AGENT_PLIST"; fi
    else skip "LaunchAgent" "не установлен (sudo ocbar install)"; fi
    if sup_alive; then
        local sp smt run; sp=$(cat "$SUP_PID")
        smt=$(stat -f %m "$SELF" 2>/dev/null || echo 0); run=$(cat "$SUP_CODE" 2>/dev/null || echo 0)
        if [ "$run" = "$smt" ]; then
            ok "Супервизор" "pid $sp, код актуален"
        elif [ "$run" = 0 ]; then
            warn "Супервизор" "pid $sp — версия кода неизвестна (запущен старой сборкой): ocbar supervisor restart"
        else
            warn "Супервизор" "pid $sp работает по коду от $(date -r "$run" '+%H:%M:%S'), файл правился в $(date -r "$smt" '+%H:%M:%S') — подхватит сам в течение 5 с"
        fi
    else
        skip "Супервизор" "не запущен"
    fi
    ok "Активный интерфейс" "$(active_service "$(active_iface)" 2>/dev/null || echo ?) ($(active_iface))"
    case "$(tunnel_state)" in
        connected) ok "Туннель" "$(env_get TUNDEV) $(env_get IP4)" ;;
        starting) warn "Туннель" "запускается" ;;
        down) if pgrep -x openconnect >/dev/null; then skip "Туннель" "чужой openconnect работает (не наш pidfile)"; else skip "Туннель" "не поднят"; fi ;;
    esac
    info "----------------------------------------"; info "Мусор от прошлых сессий"
    local n; n=$(services_with_localhost_dns | grep -c . || true)
    if [ "${n:-0}" -gt 0 ] && ! port53_busy; then bad "интерфейсов с DNS 127.0.0.1 при мёртвом резолвере: $n"; issues=$((issues+1))
    elif [ "${n:-0}" -gt 0 ]; then skip "интерфейсов с DNS 127.0.0.1: $n (на :53 кто-то отвечает — похоже, штатно)"
    else ok "DNS интерфейсов" "чисто"; fi
    if [ "$(manifest_zones | grep -c .)" -gt 0 ] && ! tunnel_alive; then bad "наши зоны /etc/resolver есть, а туннель не поднят"; issues=$((issues+1)); fi
    if [ -s "$ROUTES_STATE" ] && ! tunnel_alive; then bad "маршруты без живого туннеля: $(wc -l < "$ROUTES_STATE" | tr -d ' ')"; issues=$((issues+1)); else ok "Маршруты" "чисто"; fi
    if [ "$(env_get STATE)" = connected ] && ! tunnel_alive; then bad "tunnel.env говорит connected, а openconnect мёртв"; issues=$((issues+1)); fi
    info "----------------------------------------"
    [ "$issues" = 0 ] && info "Проблем не найдено." || info "Проблем: $issues. Починить — ocbar cleanup"
    return 0
}

# ----------------------------------------------------------------- пауза ----
# Хелпер лежит в root-каталоге и обновляется только через `sudo ocbar install`,
# поэтому он легко оказывается старее CLI. Проверяем явно, а не ловим невнятный
# usage от неизвестной подкоманды.
helper_supports_pause() {
    local h v; h=$(helper_path) || return 1
    v=$("$h" version 2>/dev/null | awk '{print $2}')
    case "$v" in ''|0.1.*) return 1 ;; *) return 0 ;; esac
}
require_fresh_helper() {
    helper_supports_pause && return 0
    die "установленный хелпер старее CLI и не умеет паузу — обновите: sudo $SELF_ENTRY install"
}

cmd_pause() {
    require_fresh_helper
    case "$(tunnel_state)" in
        paused)    info "уже на паузе"; return 0 ;;
        connected) ;;
        *) die "туннель не поднят — паузить нечего" ;;
    esac
    priv suspend
    [ "$DRY_RUN" = 1 ] || { log "пауза"; notify "ocbar: пауза" "Маршруты и зоны сняты, туннель и вход сохранены"; cmd_status; }
}

cmd_resume() {
    require_fresh_helper
    case "$(tunnel_state)" in
        paused) ;;
        connected) info "паузы нет, всё уже на месте"; return 0 ;;
        *) die "туннель не поднят — возобновлять нечего" ;;
    esac
    priv resume
    [ "$DRY_RUN" = 1 ] || { log "возобновлено"; notify "ocbar: возобновлено" "Маршруты и зоны вернулись"; report_health || true; cmd_status; }
}

cmd_toggle_pause() {
    if is_paused; then cmd_resume; else cmd_pause; fi
}

cmd_cleanup() { priv cleanup; }

# ------------------------------------------------------------ supervise ----
# Цикл: держать туннель профиля из $DESIRED. Опрос раз в 5 с (DECISIONS D9).
wake_ts() { sysctl -n kern.waketime 2>/dev/null | sed -n 's/.*sec = \([0-9]*\).*/\1/p'; }
primary_iface() { scutil <<< 'show State:/Network/Global/IPv4' 2>/dev/null | awk '/PrimaryInterface/{print $3}'; }
# 0 = туннель отвечает (или спросить нечего — тогда критерий только процесс).
# Важно: спрашивать резолвер шлюза можно ТОЛЬКО если до него есть маршрут
# через туннель. Иначе проба честно проваливается на здоровом туннеле —
# например, когда сеть с этим резолвером выключена в меню или её нет в
# networks.conf, — и супервизор устраивает переподключение на ровном месте.
tunnel_probe() {
    local dns dev; dns=$(env_get DNS); dns="${dns%% *}"
    [ -n "$dns" ] || return 0
    dev=$(env_get TUNDEV); [ -n "$dev" ] || return 0
    [ "$(route_via "$dns/32")" = "$dev" ] || return 0
    dig +time=2 +tries=1 @"$dns" . NS >/dev/null 2>&1
}

cmd_supervise() {
    local iterations=0 a
    for a in "$@"; do case "$a" in --iterations=*) iterations="${a#*=}" ;; esac; done
    mkdir -p "$USER_STATE" "$LOG_DIR"
    if sup_alive && [ "$(cat "$SUP_PID")" != $$ ]; then die "супервизор уже работает (pid $(cat "$SUP_PID"))"; fi
    printf '%s\n' $$ > "$SUP_PID"
    trap 'rm -f "$SUP_PID"; log "супервизор остановлен"; exit 0' INT TERM EXIT
    log "супервизор запущен (pid $$, dry-run=$DRY_RUN)"
    rotate_log "$SUP_LOG" "${OCBAR_LOG_MAX:-1048576}" 2

    # bash держит функции в памяти: после правки скрипта живой супервизор
    # продолжает работать по СТАРОМУ коду. Один раз это уже стоило цикла
    # неверных TOTP и 401 (DECISIONS D15). Поэтому следим за своим файлом
    # и перезапускаемся через exec — pid сохраняется, pidfile остаётся верным.
    local self_mtime; self_mtime=$(stat -f %m "$SELF" 2>/dev/null || echo 0)
    # Перезапуск идёт через exec: pid и время старта процесса не меняются,
    # поэтому по ним нельзя понять, свежий ли внутри код. Записываем версию явно.
    printf '%s\n' "$self_mtime" > "$SUP_CODE"

    # Сколько ждать, пока openconnect восстановит связь сам. Убивать его
    # раньше — значит менять целую сессию (новый SAML и одноразовый код) там,
    # где хватило бы нескольких секунд терпения.
    local reconnect_grace="${OCBAR_RECONNECT_GRACE:-100}"
    # Предохранитель от шторма: полный вход тратит одноразовый код, а несколько
    # неверных подряд блокируют учётную запись. Больше этого числа входов за
    # час супервизор не делает — ждёт человека.
    local logins_max="${OCBAR_LOGINS_PER_HOUR:-6}" logins_win_start=0 logins=0
    local last_wake last_iface backoff=5 next_try=0 n=0 desired st now wake iface
    local probe_bad_since=0 last_probe_log=0
    last_wake=$(wake_ts); last_iface=$(primary_iface)

    # Хвосты от прошлой сессии (аварийное завершение, перезагрузка) убирает
    # только connect. Если профиль снят, зоны и маршруты висели бы вечно.
    if [ ! -f "$DESIRED" ] && { [ "$(manifest_zones | grep -c . || true)" -gt 0 ] || [ -s "$ROUTES_STATE" ]; } && ! tunnel_alive; then
        log "при старте найдены следы прошлой сессии без туннеля — убираю"
        priv cleanup >>"$SUP_LOG" 2>&1 || true
    fi
    while :; do
        n=$((n+1)); now=$(date +%s)
        if [ "$(stat -f %m "$SELF" 2>/dev/null || echo 0)" != "$self_mtime" ]; then
            log "скрипт изменился — перезапускаю себя (exec)"
            trap - INT TERM EXIT
            exec "$SELF" supervise "$@"
        fi
        desired=$(cat "$DESIRED" 2>/dev/null || true)
        st=$(tunnel_state)
        wake=$(wake_ts); iface=$(primary_iface)
        if [ "$wake" != "$last_wake" ]; then
            log "событие: пробуждение ($(date -r "$wake" '+%H:%M:%S' 2>/dev/null))"; last_wake="$wake"; next_try=0; backoff=5
            [ "$DRY_RUN" = 1 ] || sleep 3   # сети нужно время после сна
        fi
        if [ "$iface" != "$last_iface" ]; then
            log "событие: смена интерфейса $last_iface → ${iface:-нет}"
            last_iface="$iface"; probe_bad_since=0; next_try=0; backoff=5
            # Восстановиться по старому локальному адресу openconnect не сможет
            # («Can't assign requested address» в логе), поэтому ждать смысла
            # нет: сразу закрываем сессию и заходим заново.
            if [ "$st" = connected ] && [ -n "$desired" ]; then
                log "смена интерфейса — восстановление по старому адресу невозможно, переподключаюсь"
                priv tunnel-stop || true
                st=down; next_try=0
            fi
        fi

        # Отсчёт потери связи имеет смысл только в connected. Иначе после
        # паузы или чужого переподключения первая же неудачная проба увидит
        # «ждём три часа» и мгновенно порвёт живую сессию.
        [ "$st" = connected ] || { probe_bad_since=0; rm -f "$LINK_LOST" 2>/dev/null || true; }

        if [ -n "$desired" ]; then
            if [ "$st" = paused ]; then
                # На паузе DNS шлюза недостижим по определению — проверять
                # туннель его опросом нельзя, живость процесса и есть критерий.
                backoff=5
            elif [ "$st" = connected ]; then
                if tunnel_probe; then
                    backoff=5
                    # маршруты могли слететь при пересоздании utun
                    local dev miss; dev=$(env_get TUNDEV); miss=""
                    while read -r net; do [ -n "$net" ] && [ "$(route_via "$net")" != "$dev" ] && miss="$miss $net"; done <<< "$(active_networks)"
                    if [ -n "$miss" ]; then log "маршруты пропали:$miss — восстанавливаю"; for net in $miss; do priv route-add "$net" || true; done; fi
                    if [ "$probe_bad_since" != 0 ]; then
                        log "связь восстановилась сама за $((now - probe_bad_since)) с — вход не потребовался"
                        notify "ocbar: связь восстановлена" "openconnect поднял сессию сам, без повторного входа"
                    fi
                    rm -f "$LINK_LOST" 2>/dev/null || true
                    probe_bad_since=0; backoff=5
                else
                    # Процесс жив — значит openconnect либо ещё держит связь,
                    # либо сам её восстанавливает. Не мешаем: новый вход стоит
                    # одноразового кода и новой сессии на шлюзе.
                    # Отметку видит меню: пока она стоит, показывается не
                    # «подключено», а «связь пропала, идёт восстановление».
                    [ "$probe_bad_since" = 0 ] && { probe_bad_since=$now; last_probe_log=0; printf '%s\n' "$now" > "$LINK_LOST"; }
                    local waited=$((now - probe_bad_since))
                    if [ $((now - last_probe_log)) -ge 20 ]; then
                        log "связи нет $waited с — жду, openconnect восстанавливает сессию сам (до $reconnect_grace с)"
                        last_probe_log=$now
                    fi
                    if [ "$waited" -ge "$reconnect_grace" ]; then
                        log "за $waited с сессия не восстановилась — закрываю и захожу заново"
                        notify "ocbar: связь потеряна" "Сессия не восстановилась за $waited с, подключаюсь заново"
                        priv tunnel-stop || true
                        probe_bad_since=0; rm -f "$LINK_LOST" 2>/dev/null || true
                        # Этот путь тоже наращивает задержку: раньше он её
                        # сбрасывал, и при стабильно неудачной пробе получался
                        # полный вход каждые сто секунд без конца.
                        next_try=$((now + backoff)); backoff=$((backoff * 2)); [ $backoff -gt 300 ] && backoff=300
                    fi
                fi
            elif [ "$st" = starting ]; then
                :
            elif is_paused; then
                # Туннель умер, но человек просил «как будто выключен».
                # Молча поднимать и отменять его решение — нельзя.
                if [ $((now - last_probe_log)) -ge 300 ]; then
                    log "туннель не поднят, но стоит пауза — не подключаюсь (ocbar resume отменит паузу)"
                    last_probe_log=$now
                fi
            elif [ "$now" -ge "$next_try" ]; then
                if [ $((now - logins_win_start)) -ge 3600 ]; then logins_win_start=$now; logins=0; fi
                if [ "$logins" -ge "$logins_max" ]; then
                    if [ $((now - last_probe_log)) -ge 300 ]; then
                        log "за час уже $logins входов — больше не пробую автоматически (ocbar connect вручную)"
                        notify "ocbar: слишком много входов" "Автоподключение приостановлено, чтобы не заблокировать учётную запись"
                        last_probe_log=$now
                    fi
                    sleep 5; continue
                fi
                if [ -f "$NEEDS_LOGIN" ]; then
                    if [ $((now - last_probe_log)) -ge 600 ]; then
                        log "жду решения человека: нужен вход (ocbar connect)"
                        last_probe_log=$now
                    fi
                    [ "$iterations" -gt 0 ] && [ "$n" -ge "$iterations" ] && break
                    sleep 5; continue
                fi
                logins=$((logins + 1))
                log "туннель не поднят, профиль $desired — подключаю молча (вход $logins/$logins_max за час)"
                local crc=0
                ( export OCBAR_SILENT=1; load_profile "$desired" && do_connect ) >>"$SUP_LOG" 2>&1 || crc=$?
                if [ "$crc" = 0 ]; then
                    backoff=5
                elif [ "$crc" = 5 ]; then
                    # Сессия у провайдера входа истекла: молча не пройти.
                    # Дальше решает человек — сами окно не открываем.
                    mkdir -p "$USER_STATE"; : > "$NEEDS_LOGIN"
                    log "молча войти не удалось — нужен вход человеком, автопопытки остановлены"
                    notify "ocbar: нужен вход" "Сессия истекла. Откройте терминал: ocbar connect"
                else
                    log "подключение не удалось, следующая попытка через $backoff с"
                    [ "$backoff" -ge 40 ] && notify "ocbar: не удаётся подключиться" "Попытки продолжаются, следующая через $backoff с"
                    next_try=$((now + backoff)); backoff=$((backoff * 2)); [ $backoff -gt 300 ] && backoff=300
                fi
            fi
        else
            if [ "$st" != down ] && [ "$(env_get MODE)" != "" ]; then
                log "профиль снят, а туннель жив — отключаю"; priv tunnel-stop || true
            fi
        fi

        [ $((n % 60)) = 0 ] && rotate_log "$SUP_LOG" "${OCBAR_LOG_MAX:-1048576}" 2
        [ "$iterations" -gt 0 ] && [ "$n" -ge "$iterations" ] && break
        sleep 5
    done
}

# --------------------------------------------------------------- install ----
# Единственная команда с sudo. Каждое действие печатается; --dry-run — только печать.
cmd_install() {
    local trust_only=0 a; for a in "$@"; do case "$a" in --trust) trust_only=1 ;; esac; done
    local me="${SUDO_USER:-$(id -un)}" home uid
    home=$(dscl . -read "/Users/$me" NFSHomeDirectory 2>/dev/null | awk '{print $2}'); home="${home:-$HOME}"
    uid=$(id -u "$me")
    if [ "$(id -u)" != 0 ] && [ "$DRY_RUN" = 0 ]; then die "нужен root: sudo $SELF_ENTRY install"; fi
    local src_helper; src_helper=$(helper_source) \
        || die "нет libexec/ocbar-helper рядом с $SELF — установка возможна только из дерева проекта"
    [ "$src_helper" = "$HELPER_INSTALLED" ] && die "источник и приёмник совпали ($src_helper) — запускайте install из каталога проекта"
    local oc; oc=$(openconnect_bin) || die "brew install openconnect"
    local vpnc="$(dirname "$(dirname "$oc")")/etc/vpnc/vpnc-script"
    local -a steps=()
    if [ "$trust_only" = 0 ]; then
        steps+=("install -d -o root -g wheel -m 755 $LIBDIR $LIBDIR/csd $PREFIX/etc/ocbar $STATE_DIR")
        steps+=("install -o root -g wheel -m 755 $src_helper $HELPER_INSTALLED")
        [ -f "$vpnc" ] && steps+=("install -o root -g wheel -m 755 $vpnc $LIBDIR/vpnc-script-full")
        local p csd
        while read -r p; do
            [ -n "$p" ] || continue
            csd=$(OCBAR_CONFIG_DIR="$home/.config/ocbar" profile_get "$p" csd_wrapper); csd="${csd/#\~/$home}"
            [ -n "$csd" ] && [ -f "$csd" ] && steps+=("install -o root -g wheel -m 755 $csd $LIBDIR/csd/$(basename "$csd")")
        done <<< "$(PROFILES="$home/.config/ocbar/profiles.conf" profile_list)"
    fi
    steps+=("install -o root -g wheel -m 755 $oc $LIBDIR/openconnect")
    steps+=("$HELPER_INSTALLED trust")
    if [ "$trust_only" = 0 ]; then
        steps+=("printf '%%admin ALL=(root) NOPASSWD: $HELPER_INSTALLED\\n' > /etc/sudoers.d/ocbar && chmod 440 /etc/sudoers.d/ocbar && visudo -cf /etc/sudoers.d/ocbar")
        steps+=("install -d -o $me -m 755 $home/Library/LaunchAgents $home/Library/Logs/ocbar")
        steps+=("write-plist $home/Library/LaunchAgents/$AGENT_LABEL.plist")
        # Загруженный агент не трогаем: супервизор подхватывает новый код сам
        # (следит за mtime), а bootout убил бы живой туннель вместе с задачей.
        if sudo -u "$me" launchctl print "gui/$uid/$AGENT_LABEL" >/dev/null 2>&1; then
            steps+=("echo '  агент уже загружен — не перезапускаю (супервизор подхватит код сам); принудительно: ocbar supervisor restart'")
        else
            steps+=("sudo -u $me launchctl bootstrap gui/$uid $home/Library/LaunchAgents/$AGENT_LABEL.plist")
        fi
    fi
    local s rc
    for s in "${steps[@]}"; do
        printf '  %s$ %s%s\n' "$c_dim" "$s" "$c_off"
        [ "$DRY_RUN" = 1 ] && continue
        rc=0
        case "$s" in
            "write-plist "*) write_plist "${s#write-plist }" "$me" || rc=$? ;;
            "$HELPER_INSTALLED trust") "$HELPER_INSTALLED" trust || rc=$? ;;
            *) bash -c "$s" || rc=$? ;;
        esac
        # Установка идёт по шагам, и оборваться молча на середине — худший
        # исход: часть файлов новая, часть старая, и это не видно.
        [ "$rc" = 0 ] || die "шаг не выполнен (код $rc): $s"$'\n'"состояние установки неполное — исправьте причину и повторите"
    done
    [ "$DRY_RUN" = 1 ] && { info "[dry-run] ничего не сделано. Плист выглядел бы так:"; plist_body "$me" | sed 's/^/    /'; return 0; }
    ok "установлено. Проверка: ocbar doctor"
}
plist_body() { # user
    cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$AGENT_LABEL</string>
  <key>ProgramArguments</key><array><string>$SELF_ENTRY</string><string>supervise</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>StandardOutPath</key><string>/Users/$1/Library/Logs/ocbar/supervisor.out</string>
  <key>StandardErrorPath</key><string>/Users/$1/Library/Logs/ocbar/supervisor.err</string>
</dict></plist>
PLIST
}
write_plist() { plist_body "$2" > "$1"; chown "$2" "$1"; chmod 644 "$1"; plutil -lint "$1" >/dev/null; }

# ------------------------------------------------------------ supervisor ----
cmd_supervisor() {
    local sub="${1:-status}" uid; uid=$(id -u)
    case "$sub" in
        status)
            if launchctl print "gui/$uid/$AGENT_LABEL" >/dev/null 2>&1; then ok "LaunchAgent" "загружен"; else warn "LaunchAgent" "не загружен"; fi
            sup_alive && ok "Процесс" "pid $(cat "$SUP_PID")" || skip "Процесс" "не работает"
            [ -f "$SUP_LOG" ] && { info ""; info "Последние записи:"; tail -5 "$SUP_LOG" | sed 's/^/  /'; } ;;
        start)
            [ -f "$AGENT_PLIST" ] || die "нет $AGENT_PLIST — sudo ocbar install"
            launchctl bootstrap "gui/$uid" "$AGENT_PLIST" && ok "агент загружен" ;;
        stop)
            launchctl bootout "gui/$uid/$AGENT_LABEL" 2>/dev/null
            info "агент выгружен (туннель это переживёт: openconnect в своей сессии)" ;;
        restart)
            if launchctl print "gui/$uid/$AGENT_LABEL" >/dev/null 2>&1; then
                launchctl kickstart -k "gui/$uid/$AGENT_LABEL" && ok "агент перезапущен"
            else
                cmd_supervisor start
            fi ;;
        *) die "supervisor: status | start | stop | restart" ;;
    esac
}

cmd_uninstall() {
    local me="${SUDO_USER:-$(id -un)}" uid; uid=$(id -u "$me")
    local -a steps=("launchctl bootout gui/$uid/$AGENT_LABEL" "rm -f /Users/$me/Library/LaunchAgents/$AGENT_LABEL.plist"
                    "rm -f /etc/sudoers.d/ocbar" "rm -rf $LIBDIR $HELPER_INSTALLED $PREFIX/etc/ocbar")
    local s; for s in "${steps[@]}"; do printf '  %s$ %s%s\n' "$c_dim" "$s" "$c_off"; [ "$DRY_RUN" = 1 ] || bash -c "$s" || true; done
    [ "$DRY_RUN" = 1 ] || info "состояние в $STATE_DIR оставлено; ocbar cleanup перед удалением"
}

# ---------------------------------------------------------- разметка ----
# Форма провайдера входа у каждой компании своя, а встроенные правила
# покрывают только типовые. Разметка — способ объяснить программе чужую
# форму мышью: человек показывает поля и кнопку, правила пишутся сами.
cmd_learn() {
    local p="" out="" a
    while [ $# -gt 0 ]; do
        case "$1" in
            --out) out="${2:-}"; shift 2 ;;
            -*) die "learn: --out <файл>" ;;
            *) p="$1"; shift ;;
        esac
    done
    load_profile "$p"
    local auth; auth=$(auth_path) || die "не найден ocbar-auth — собрать: (cd auth && swift build -c release)"
    local target="$out"
    [ -n "$target" ] || target="${P_RULES:-$RULES_FILE}"
    info "Разметка формы входа: профиль [$P_NAME], $P_URL"
    info "  открою форму; отмечайте поля и кнопку мышью, потом «Готово»"
    info "  правила лягут в $target (прошлые — туда же с суффиксом .bak)"
    local rc=0
    "$auth" --learn --url "$P_URL" --useragent "$P_UA" --out "$target" >/dev/null || rc=$?
    case "$rc" in
        0)  ok "правила записаны" "$target"
            info "что получилось:"; sed 's/^/    /' "$target"
            info "проверить на живом входе: ocbar connect --show" ;;
        3)  info "разметка отменена — файл не тронут" ;;
        *)  die "разметка не удалась (код $rc)" ;;
    esac
}

# --------------------------------------------------------- приложение ----
# Приложение меню-бара — обычный бандл без привилегий. Оно ставится вместе
# с остальным, но запускать и заводить в автозапуск его должен человек:
# значок в меню-баре появляется молча, а решение «пусть будет всегда» — не
# наше.
app_path() {
    local c
    for c in "${OCBAR_APP:-}" "$SELF_DIR/../ocbar.app" "$SELF_DIR/../app/.build/ocbar.app" \
             /opt/homebrew/opt/ocbar/ocbar.app /usr/local/opt/ocbar/ocbar.app \
             /Applications/ocbar.app; do
        [ -n "$c" ] && [ -d "$c" ] && { printf '%s' "$(cd "$c" && pwd)"; return 0; }
    done
    return 1
}
app_pid() { pgrep -f 'ocbar\.app/Contents/MacOS/ocbar-app' 2>/dev/null | head -1 || true; }

app_plist_body() { # путь к бандлу
    cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$APP_LABEL</string>
  <key>ProgramArguments</key><array><string>$1/Contents/MacOS/ocbar-app</string></array>
  <key>RunAtLoad</key><true/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
</dict></plist>
PLIST
}

cmd_app() {
    local uid; uid=$(id -u)
    local a; a=$(app_path) || true
    case "${1:-start}" in
        start)
            [ -n "$a" ] || die "не найден ocbar.app (соберите: app/make-app.sh, или brew install)"
            [ -n "$(app_pid)" ] && { info "уже работает (pid $(app_pid))"; return 0; }
            open "$a" && ok "запущено" "$a" ;;
        stop)
            local p; p=$(app_pid)
            [ -n "$p" ] || { info "не работает"; return 0; }
            kill "$p" && ok "остановлено" "pid $p" ;;
        status)
            [ -n "$a" ] && ok "Бандл" "$a" || bad "Бандл" "не найден"
            local p; p=$(app_pid)
            [ -n "$p" ] && ok "Процесс" "pid $p" || skip "Процесс" "не запущено"
            if [ -f "$APP_PLIST" ]; then
                launchctl print "gui/$uid/$APP_LABEL" >/dev/null 2>&1 \
                    && ok "Автозапуск" "включён" || warn "Автозапуск" "plist есть, но агент не загружен"
            else
                skip "Автозапуск" "выключен (ocbar app autostart on)"
            fi ;;
        autostart)
            case "${2:-}" in
                on)
                    [ -n "$a" ] || die "не найден ocbar.app"
                    # В плист пишем путь, который переживает переустановку:
                    # каталог opt Homebrew не меняется от версии к версии, а
                    # путь внутри дерева проекта меняется вместе с деревом.
                    local stable="$a" c
                    for c in /opt/homebrew/opt/ocbar/ocbar.app /usr/local/opt/ocbar/ocbar.app; do
                        [ -d "$c" ] && { stable="$c"; break; }
                    done
                    case "$stable" in
                        */opt/ocbar/ocbar.app) ;;
                        *) warn "автозапуск" "путь $stable из дерева проекта; после переустановки повторите ocbar app autostart on" ;;
                    esac
                    mkdir -p "$HOME/Library/LaunchAgents"
                    app_plist_body "$stable" > "$APP_PLIST"
                    plutil -lint "$APP_PLIST" >/dev/null || die "плист не разобрался"
                    launchctl bootout "gui/$uid/$APP_LABEL" 2>/dev/null || true
                    launchctl bootstrap "gui/$uid" "$APP_PLIST" && ok "автозапуск включён" "$stable" ;;
                off)
                    launchctl bootout "gui/$uid/$APP_LABEL" 2>/dev/null || true
                    rm -f "$APP_PLIST"; ok "автозапуск выключен" ;;
                *) die "app autostart on|off" ;;
            esac ;;
        *) die "app: start | stop | status | autostart on|off" ;;
    esac
}

# ---------------------------------------------------------------- версии ----
# `version --all` — машинный вид для приложения: что установлено, какой
# версии и где лежит. Поиск бинарников живёт здесь, чтобы приложению не
# пришлось повторять его у себя и расходиться с CLI.
cmd_version() {
    [ "${1:-}" = "--all" ] || { printf 'ocbar %s\n' "$VERSION"; return 0; }
    local h a oc
    printf 'ocbar=%s\nocbar_path=%s\n' "$VERSION" "$SELF_ENTRY"
    if h=$(helper_path); then
        printf 'helper=%s\nhelper_path=%s\nhelper_nopasswd=%s\n' \
            "$("$h" version 2>/dev/null | awk '{print $2}')" "$h" \
            "$(helper_nopasswd && echo 1 || echo 0)"
    fi
    a=$(auth_path) && printf 'auth_path=%s\n' "$a"
    a=$(app_path) && printf 'app_path=%s\n' "$a"
    if oc=$(openconnect_bin); then
        printf 'openconnect=%s\nopenconnect_path=%s\n' \
            "$("$oc" --version 2>&1 | head -1 | awk '{print $3}')" "$oc"
    fi
    [ -x "$LIBDIR/openconnect" ] && printf 'openconnect_root=%s\n' "$LIBDIR/openconnect"
    printf 'config_dir=%s\nprofile_dir=%s\nstate_dir=%s\nsupervisor_log=%s\nopenconnect_log=%s\n' \
        "$CONFIG_DIR" "$PROFILE_DIR" "$STATE_DIR" "$SUP_LOG" "$OC_LOG"
    printf 'supervisor=%s\n' "$(sup_alive && echo 1 || echo 0)"
    return 0
}

# ------------------------------------------------------------------ main ----
usage() {
    cat <<'USAGE'
ocbar — OpenConnect для macOS: SSO, split DNS, split tunneling, супервизор.

  ocbar connect [профиль] [--show]   подключиться (окно SSO покажется при необходимости)
  ocbar disconnect                    отключиться
  ocbar pause                         «как будто выключен»: снять маршруты и зоны,
                                      туннель и вход оставить живыми
  ocbar resume                        вернуть маршруты и зоны (мгновенно, без входа)
  ocbar toggle                        pause ↔ resume
  ocbar status [--short]              состояние; --short — машинный вид для меню
  ocbar profiles                      список профилей
  ocbar import <файл.ocbar> [имя]     добавить профиль одним файлом
  ocbar export <профиль> [файл]       выгрузить профиль (и перевести в новый формат)
  ocbar routes add|del|toggle <CIDR>  маршруты в туннель на лету; apply | clear
  ocbar dns status|apply|clear        зоны /etc/resolver; on|off|toggle <зона>
  ocbar dns init <файл> <DNS|vpn>     создать zones.conf из списка доменов
  ocbar secret set-password|set-totp|status [профиль]   Keychain
  ocbar secret import-qr <файл> [--list] [--select ИМЯ] [профиль]
                                      TOTP из QR (в т.ч. экспорт Google
                                      Authenticator); секрет не печатается
  ocbar learn [профиль] [--out файл]  разметить форму входа мышью: правила
                                      автозаполнения для своего портала
  ocbar app [start|stop|status]       приложение меню-бара; autostart on|off
  ocbar ui-lab [--live]               песочница интерфейса в браузере
  ocbar version [--all]               версия; --all — все части и пути, для приложения
  ocbar doctor                        диагностика, ничего не меняет
  ocbar cleanup                       мусор от прошлой сессии
  ocbar supervise                     цикл реконнекта (его запускает LaunchAgent)
  ocbar supervisor status|restart     состояние и перезапуск агента супервизора
  sudo ocbar install [--trust]        хелпер, sudoers, LaunchAgent (один раз)
  sudo ocbar uninstall

  --dry-run   печатать привилегированные команды вместо выполнения

Конфиги: ~/.config/ocbar/{profiles.conf,zones.conf,networks.conf,autofill.rules}
USAGE
}

args=()
for a in "$@"; do case "$a" in --dry-run) DRY_RUN=1 ;; -h|--help) usage; exit 0 ;; *) args+=("$a") ;; esac; done
set -- "${args[@]+"${args[@]}"}"

case "${1:-}" in
    connect)    shift; cmd_connect "$@" ;;
    disconnect) cmd_disconnect ;;
    status)     cmd_status "${2:-}" ;;
    profiles)   cmd_profiles ;;
    routes)     shift; cmd_routes "$@" ;;
    dns)        shift; cmd_dns "$@" ;;
    secret)     shift; cmd_secret "$@" ;;
    pause)      cmd_pause ;;
    resume)     cmd_resume ;;
    toggle)     cmd_toggle_pause ;;
    ui-lab)     shift; cmd_ui_lab "$@" ;;
    app)        shift; cmd_app "$@" ;;
    learn)      shift; cmd_learn "$@" ;;
    import)     shift; cmd_import "$@" ;;
    export)     shift; cmd_export "$@" ;;
    supervisor) shift; cmd_supervisor "$@" ;;
    doctor)     cmd_doctor ;;
    cleanup)    cmd_cleanup ;;
    supervise)  shift; cmd_supervise "$@" ;;
    install)    shift; cmd_install "$@" ;;
    uninstall)  cmd_uninstall ;;
    version)    shift; cmd_version "${1:-}" ;;
    ''|help)    usage ;;
    *) usage; exit 1 ;;
esac
