# ocbar: профили подключения. Копировать в ~/.config/ocbar/profiles.conf.
#
# default = имя профиля, который берёт `ocbar connect` без аргумента.
# В секции [имя]:
#   url              host/group — как в openconnect (https:// можно не писать)
#   name             человеческое имя для меню
#   description      подпись под профилем в списке и в меню
#   keepass_entry    путь записи в KeePassXC, чей одноразовый код брать;
#                    задан — включает totp = keepassxc
#   keepass_db       путь к файлу базы (по умолчанию — переменная KP_DB)
#   keepass_keychain_service  где лежит мастер-пароль базы (по умолч. keepassxc-docs)
#   user             логин; по умолчанию — текущий пользователь macOS
#   auth             sso (по умолчанию) | password — парольные группы ocbar не ведёт,
#                    они здесь только чтобы меню показывало «через openconnect»
#   mode             split — в туннель идут только сети из networks.conf.
#                    Единственный режим: «всё в туннель» делается двумя
#                    строками в networks.conf (0.0.0.0/1 и 128.0.0.0/1), но
#                    шлюз при этом может не выпускать в интернет
#   useragent        User-Agent для шлюза; по умолчанию AnyConnect Windows 4.10.06079
#   keychain_service сервис Keychain, где лежат пароль (-a user) и TOTP (-a totp/user);
#                    по умолчанию ru.ocbar.client
#   csd_wrapper      путь к hostscan-заглушке; sudo ocbar install скопирует её в root-каталог
#   rules            файл правил автозаполнения; по умолчанию ~/.config/ocbar/autofill.rules
#   idp_hosts        через запятую: где разрешено автозаполнять форму входа.
#                    Пусто — на любой странице (тогда хост каждой пишется в лог).
#                    Заполнено — чужая страница получит окно, а не ваш пароль
#   healthcheck      что проверить после подключения: URL, «хост:порт» или имя
#                    (тогда проверяется, что оно резолвится). Поднятый интерфейс
#                    и работающий доступ — разные вещи
#   password         откуда брать пароль: auto (по умолчанию) | keychain | keepassxc |
#                    command | ask. auto — команда, если задана password_command;
#                    иначе Keychain, если пароль там есть; иначе KeePassXC, если
#                    задан keepass_entry. ask — вводит человек
#   password_command команда, печатающая пароль (для password = command)
#   totp             откуда брать одноразовый код: auto (по умолчанию) | keychain |
#                    keepassxc | command | sms | off. auto — команда, если задана
#                    totp_command; иначе KeePassXC, если задан keepass_entry; иначе
#                    Keychain. sms и off — код вводит человек: чужой код в поле
#                    хуже пустого
#   totp_command     команда, печатающая код из 6–8 цифр (для totp = command)

# Глобальные ключи (до первой секции):
#   notifications = on | off   уведомления системы о смене состояния (по умолчанию on)

default = main

[main]
url = vpn.example.com/employees
name = Основной
description = Любые устройства, расширенный доступ
user = alice
mode = split
healthcheck = wiki.example.com:443

[legacy]
url = vpn.example.com/otp
name = Парольная группа
# логин, пароль и код из SMS: пароль ocbar подставит, код спросит окном
auth = password
